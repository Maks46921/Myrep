				"auto": 6.0,
				"infra": 66.0,
				"edu": 74.0,
				"health": 70.0,
				"env": 55.0,
				"loy": 49.3,
				"desc": "Столица и почти 40 % населения: правительство, Клинический центр, университет, банки и торговые центры, алюминиевый комбинат KAP на окраине. Старая королевская столица Цетине — оплот черногорской идентичности и DPS, Тузи — албанская община, Зета и Даниловград — сады и виноградники «Плантаже». Пробки, дорогие квартиры и самая сильная PES.",
				"sh": [0.287, 0.218, 0.119, 0.089, 0.025, 0.054, 0.079, 0.04, 0.04, 0.05]
