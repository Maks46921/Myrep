			"Платф."
		],
		"seats": [4, 5, 8, 6, 3, 2, 4, 5, 4, 1],
		"regions": [
			{
				"id": "BA-SAR",
				"code": "SAR",
				"name": "Сараево и Боснийское Подринье (Сараево, Илиджа, Горажде)",
