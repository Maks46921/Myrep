		"def": 3.6,
		"stab": 55,
		"appr": 34,
		"gov": "правительство Спаича: «Европа сейчас!», «За будущее Черногории», Демократы, Боснийская партия и албанские партии",
		"gov_party": "Европа сейчас!",
		"pot": 2.8,
