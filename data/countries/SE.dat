	"PARTY_NAMES": [
		"Умеренная коалиционная партия (M)",
		"Социал-демократическая рабочая партия (S)",
		"Либералы (L)",
		"Партия левых (V)",
		"Партия окружающей среды — Зелёные (MP)",
		"Партия Центра (C)",
		"Христианские демократы (KD)",
		"Шведские демократы (SD)",
		"Прочие и местные списки",
