{
	"PARTY_NAMES": [
		"Швейцарская народная партия (СНП, SVP)",
		"Социал-демократическая партия (СП, SP/PS)",
		"СДП. Либералы (FDP.Die Liberalen)",
		"Центр (Die Mitte / Le Centre)",
