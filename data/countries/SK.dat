	"NEWS_C": [
		{
			"text": "Словакия выпустила больше миллиона автомобилей за год — мировой рекорд на душу населения.",
			"fx": {
				"support": {
					"Рабочие": 2.0,
					"Бизнес": 2.0
				},
				"shock": 0.2
			}
		},
		{
			"text": "Статистическое управление: инфляция в Словакии остаётся одной из самых высоких в еврозоне, главным образом из-за повышения НДС.",
			"fx": {
				"support": {
					"Пенсионеры": -2.0,
					"Рабочие": -1.0
				},
				"shock": -0.1
			}
		},
		{
			"text": "Хоккейная сборная Словакии вышла в полуфинал чемпионата мира: страна празднует на улицах.",
			"fx": {
				"all": 2.0
			}
		},
		{
			"text": "Завод Volvo под Кошице выпустил первый электромобиль: на востоке надеются на тысячи рабочих мест.",
