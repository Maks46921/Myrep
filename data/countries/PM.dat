			"cap": "Вадуц",
			"pop": 0.0405,
			"gdp": 7.0,
			"trade": 0.0,
			"rel0": 28.0,
			"w": 0.0,
			"lv0": {
				"trade": 2,
				"sec": 0,
				"energy": 1
			},
			"leader": "Глава правительства Лихтенштейна",
			"desc": "Карликовое княжество между Швейцарией и Австрией с самыми высокими доходами на душу населения в Европе: банки, фонды, высокоточные станки и стоматологические материалы, нет долга и армии. Живёт по швейцарскому франку и таможенному союзу с Берном, в ЕЭЗ без членства в ЕС, а князь сохраняет реальные полномочия — вплоть до вето на законы.",
			"likes": "верность договору о таможенном союзе, уважение к князю и прямой демократии, конкурентные налоги, бережливость бюджета, участие в ЕЭЗ и Шенгене без вступления в ЕС",
			"dislikes": "давление на финансовый центр, угрозы ввести санкции за участие в банковском секторе, отказ от швейцарского франка без согласования, вмешательство в вопросы монархии"
		},
		"MT": {
			"name": "Мальта",
			"cap": "Валлетта",
			"pop": 0.568,
			"gdp": 22.0,
			"trade": 0.0,
			"rel0": 24.0,
			"w": 0.0,
			"lv0": {
				"trade": 2,
				"sec": 0,
				"energy": 1
			},
			"leader": "Премьер-министр Мальты",
			"desc": "Остров-государство в центре Средиземного моря: член ЕС и еврозоны с нейтралитетом в Конституции, туристический, игорный, судоходный и финансовый центр. Быстро растущая экономика и дорогое жильё, запрет абортов и спор о законе после дела Каруаны Галиции, мигрантские маршруты из Ливии и Туниса.",
			"likes": "верность ЕС и евро, борьба с отмыванием денег и ужесточение надзора за гэмблингом, уважение к нейтралитету, помощь по миграции, закрытие схем продажи паспортов",
			"dislikes": "продажа гражданства, теневой флот и вторичные санкции, срывы переговоров по Ливии, пренебрежение правилами правового государства, ограничение прав женщин"
		},
		"AD": {
			"name": "Андорра",
			"cap": "Андорра-ла-Велья",
			"pop": 0.087,
			"gdp": 3.9,
			"trade": 0.0,
			"rel0": 26.0,
			"w": 0.0,
			"lv0": {
				"trade": 2,
				"sec": 0,
				"energy": 1
			},
			"leader": "Глава правительства Андорры",
			"desc": "Карликовое княжество в Пиренеях с двумя князьями (президент Франции и епископ Урхельский): горнолыжные курорты, беспошлинная торговля, банки; евро без центрального банка и ассоциация с ЕС на пороге. Страна с самым высоким в Европе средним возрастом, запретом абортов и нехваткой жилья для работников.",
			"likes": "ассоциация с ЕС, прозрачность банков, уважение к князьям-соправителям, помощь в энергетике и климатических проектах, уважение каталонской культуры",
			"dislikes": "давление на банки и налоговый режим, пренебрежение правами работников, слабая борьба с отмыванием денег, ограничение прав женщин"
		},
		"SM": {
			"name": "Сан-Марино",
			"cap": "Сан-Марино",
			"pop": 0.0345,
			"gdp": 2.0,
			"trade": 0.0,
			"rel0": 28.0,
			"w": 0.0,
			"lv0": {
				"trade": 2,
				"sec": 0,
				"energy": 1
			},
			"leader": "Секретарь по иностранным делам Сан-Марино",
			"desc": "Одна из старейших республик мира, анклав внутри Италии на горе Монте-Титано: банки, туризм, марки и торговля; два капитана-регента на полгода, евро без центрального банка и ассоциация с ЕС на финише. Малая страна, оправляющаяся от банковского кризиса и стареющая быстрее соседей.",
			"likes": "ассоциация с ЕС, прозрачность банков, уважение к нейтралитету и традициям республики, помощь в борьбе с отмыванием денег и поддержка туризма",
			"dislikes": "давление на банки, пренебрежение суверенитетом, санкции против финансового сектора, ограничение прав женщин"
		},
		"MC": {
			"name": "Монако",
			"cap": "Монако",
			"pop": 0.039,
			"gdp": 8.5,
			"trade": 0.0,
			"rel0": 26.0,
			"w": 0.0,
			"lv0": {
				"trade": 2,
				"sec": 0,
				"energy": 1
			},
			"leader": "Государственный министр Монако",
			"desc": "Княжество-город на Лазурном берегу: казино, яхты, «Формула-1», финансовый центр без подоходного налога для резидентов; княжеская власть и договор с Францией, ассоциация с ЕС на пороге. Самая дорогая недвижимость в мире и самое охраняемое государство Европы.",
			"likes": "ассоциация с ЕС с гарантиями для налогового режима, прозрачность финансового сектора, уважение к князю и Франции, поддержка океанографии и событий",
			"dislikes": "давление на налоговый режим, санкции против клиентов банков, пренебрежение идентичностью монегасков, потеря привилегий князя"
		},
		"CY": {
			"name": "Кипр",
			"cap": "Никосия",
			"pop": 0.93,
			"gdp": 34.0,
			"trade": 0.0,
			"rel0": 40.0,
			"w": 0.0,
			"lv0": {
				"trade": 2,
				"sec": 0,
				"energy": 1
			},
			"leader": "Президент Республики Кипр",
			"desc": "Остров в Восточном Средиземноморье, разделённый с 1974 года: Республика Кипр на юге — член ЕС и еврозоны, а на севере стоит турецкая армия и существует непризнанная ТРСК. Туризм, банки, судоходство и газ Афродиты; с января 2026 года Кипр председательствует в Совете ЕС.",
			"likes": "решение Кипрской проблемы по резолюциям ООН, поддержка ЕС и Греции, прозрачность банков, энергетические проекты с Израилем и Египтом, защита человеческих прав",
			"dislikes": "признание ТРСК, давление Турции, нарушения морских границ, слабая борьба с отмыванием денег, поддержка России и санкции в обход"
		}
	},
