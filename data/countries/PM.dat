{
	"PARTY_NAMES": [
		"Обновление (Obnovlenie)",
		"Коммунисты и левые активисты",
		"Республика (наследие Смирнова)",
		"Прочие движения",
		"Независимые общественные объединения",
		"Проевропейские активисты",
		"Малые партии лояльных регионов",
		"Независимые кандидаты",
		"Районные советы и главы администраций",
		"«Против всех» (протестное голосование)"
	],
