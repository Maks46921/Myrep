				"state": {
					"infra_lvl": -1.0
				}
			}
		},
		{
			"text": "Британия вышла на второе место в Европе по числу «единорогов» в сфере искусственного интеллекта.",
			"fx": {
				"shock": 0.2,
				"support": {
					"Бизнес": 2.0,
					"Молодёжь": 1.0
				}
			}
		},
		{
			"text": "Число мигрантов на малых лодках снизилось по сравнению с прошлым годом, но остаётся высоким.",
			"fx": {
				"support": {
					"Силовики": 1.0,
					"Село": 1.0
				}
			}
		},
		{
			"text": "Цены на жильё в Лондоне продолжают падать: молодёжь надеется на ипотеку, а собственники нервничают.",
			"fx": {
				"support": {
					"Молодёжь": 2.0,
					"Пенсионеры": -1.0,
					"Бизнес": -1.0
				}
			}
		},
		{
			"text": "В Шотландии опубликованы данные о росте расходов на NHS и шотландских школ: Эдинбург просит больше денег по формуле Барнетта.",
			"fx": {
