	"PARTY_NAMES": [
		"Испанская социалистическая рабочая партия (PSOE)",
		"Народная партия (PP)",
		"Сумар (Sumar)",
		"Подемос (Podemos)",
		"Вместе за Каталонию (Junts)",
		"Республиканские левые Каталонии (ERC)",
		"Прочие партии",
