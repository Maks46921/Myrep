{
	"PARTY_NAMES": [
		"Сан-маринская христианско-демократическая партия (Partito Democratico Cristiano Sammarinese, PDCS)",
		"«Свободная» и Социалистическая партия (Libera/PS)",
		"Социал-демократическая партия (Partito dei Socialisti e dei Democratici, PSD)",
