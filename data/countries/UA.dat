			"v": {
				"0": {
					"n": "20 % и льготные 14 % и 7 %",
					"d": "Действующий порядок: основная ставка 20 %, 14 % для части сельхозпродукции, 7 % для лекарств и медизделий."
				}
			}
		},
		"lobbying_law": {
			"v": {
