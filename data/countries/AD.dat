	"DE_TOPICS": [
		{
			"id": "fiscal_rule",
			"cat": 1,
			"name": "Бюджетная дисциплина и потолок долга",
			"desc": "Закон о бюджетной стабильности ограничивает дефицит 1 % ВВП и долг 40 % ВВП; бюджет почти сбалансирован, а программа с МВФ (с 2020 года Андорра — член фонда) задаёт правила банковского надзора и налоговой прозрачности. Без центрального банка страна не может печатать деньги: единственная «подушка» — резервный фонд и кредитные линии Испании и Франции.",
			"v": [
