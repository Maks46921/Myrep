	"REGIONS": [
		{
			"code": "NIC",
			"name": "Округ Никосия (столица, Тродос и зелёная линия)",
			"short": "Никосия",
			"popm": 0.378,
			"pc": 0.847,
			"dev": 80.0,
			"loy": 50.4,
			"unrest": 16.0,
