{
	"PARTY_NAMES": [
		"ВМРО-ДПМНЕ (Внутренняя македонская революционная организация — Демократическая партия македонского национального единства)",
		"ЗНАМ — «Знаю, за нашу Македонию» (ЗНАМ)",
		"Социал-демократический союз Македонии (СДСМ)",
		"ВЛЕН (Vlen: Альтернатива, БЕСА, Демократическое движение и союзники)",
		"Национальный альянс за интеграцию (ДУИ и союзники, бывший «Европейский фронт»)",
		"Социалистическая партия и партии общин (СПМ, турки, сербы, ромы, влахи)",
		"Прочие партии и независимые",
		"Правые суверенисты («Единая Македония», «Десница», «Македонская эра третья»)",
		"ДОМ и либералы (Демократическое обновление Македонии, ЛДП, НСДП)",
		"Левица (Levica)"
	],
