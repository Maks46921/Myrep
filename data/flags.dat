вство Финляндия 1918 (красно-жёлтый флаг)","ideo":["Монархия","Национализм","Консерватизм"],"y0":1918,"y1":1918,"name":"Красный флаг с золотым львом","src":"реальный","note":"Красно-жёлтый флаг 1918 г.: золотой лев с мечом и саблей и девять белых роз на красном. Рисунок льва упрощён. Уверенность 3/5"},{"id":"FI-1918B","w":98.18,"svg":"<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 98.18 60\"><rect x=\"0\" y=\"0\" width=\"98.18\" height=\"60\" fill=\"#FFFFFF\"/><rect x=\"0\" y=\"21.82\" width=\"98.18\" height=\"16.36\" fill=\"#003580\"/><rect x=\"27.27\" y=\"0\" width=\"16.36\" height=\"60\" fill=\"#003580\"/></svg>","regime":"Республика Финляндия","ideo":["Демократия","Социал-демократия","Либерализм","Консерватизм","Национализм"],"y0":1918,"y1":0,"name":"Сининристилиппу","src":"реальный","note":"Синий крест на белом (11:18), принят в 1918 г. (Сневман), с 1920 г. закреплён законом; нынешний флаг. Уверенность 5/5"}],"FR":[{"id":"FR-1500","w":90,"svg":"<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 90 60\"><rect x=\"0\" y=\"0\" width=\"90\" height=\"60\" fill=\"#1B3B9A\"/><g transform=\"translate(45 18) scale(1.3)\" fill=\"#F2C94C\"><path d=\"M0,-8 C3.2,-5 3.2,-1 0,2.4 C-3.2,-1 -3.2,-5 0,-8 Z\"/><path d=\"M-1.4,1.6 C-1.8,-3.6 -8.8,-4.2 -8.4,1 C-8.2,3.8 -5,4.8 -2.4,3.8 Z\"/><path d=\"M1.4,1.6 C1.8,-3.6 8.8,-4.2 8.4,1 C8.2,3.8 5,4.8 2.4,3.8 Z\"/><rect x=\"-5.2\" y=\"4.2\" width=\"10.4\" height=\"1.8\"/><path d=\"M-1.6,6 C-1.6,8.2 -3.4,9.2 -4.8,9.6 C-2.2,10 -0.2,8.8 0,7.6 C0.2,8.8 2.2,10 4.8,9.6 C3.4,9.2 1.6,8.2 1.6,6 Z\"/></g><g transform=\"translate(31 40) scale(1.3)\" fill=\"#F2C94C\"><path d=\"M0,-8 C3.2,-5 3.2,-1 0,2.4 C-3.2,-1 -3.2,-5 0,-8 Z\"/><path d=\"M-1.4,1.6 C-1.8,-3.6 -8.8,-4.2 -8.4,1 C-8.2,3.8 -5,4.8 -2.4,3.8 Z\"/><path d=\"M1.4,1.6 C1.8,-3.6 8.8,-4.2 8.4,1 C8.2,3.8 5,4.8 2.4,3.8 Z\"/><rect x=\"-5.2\" y=\"4.2\" width=\"10.4\" height=\"1.8\"/><path d=\"M-1.6,6 C-1.6,8.2 -3.4,9.2 -4.8,9.6 C-2.2,10 -0.2,8.8 0,7.6 C0.2,8.8 2.2,10 4.8,9.6 C3.4,9.2 1.6,8.2 1.6,6 Z\"/></g><g transform=\"translate(59 40) scale(1.3)\" fill=\"#F2C94C\"><path d=\"M0,-8 C3.2,-5 3.2,-1 0,2.4 C-3.2,-1 -3.2,-5 0,-8 Z\"/><path d=\"M-1.4,1.6 C-1.8,-3.6 -8.8,-4.2 -8.4,1 C-8.2,3.8 -5,4.8 -2.4,3.8 Z\"/><path d=\"M1.4,1.6 C1.8,-3.6 8.8,-4.2 8.4,1 C8.2,3.8 5,4.8 2.4,3.8 Z\"/><rect x=\"-5.2\" y=\"4.2\" width=\"10.4\" height=\"1.8\"/><path d=\"M-1.6,6 C-1.6,8.2 -3.4,9.2 -4.8,9.6 C-2.2,10 -0.2,8.8 0,7.6 C0.2,8.8 2.2,10 4.8,9.6 C3.4,9.2 1.6,8.2 1.6,6 Z\"/></g></svg>","regime":"Королевство Франция (Старый порядок)","ideo":["Монархия","Консерватизм"],"y0":1500,"y1":1790,"name":"Знамя Франции: лазурь с тремя золотыми лилиями","src":"реальный","note":"Королевское знамя Старого порядка (три лилии с 1376). Лилии упрощены; белый флаг флота не взят. Уверенность 4/5"},{"id":"FR-1794","w":90,"svg":"<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 90 60\"><rect x=\"0\" y=\"0\" width=\"27.05\" height=\"60\" fill=\"#0055A4\"/><rect x=\"27\" y=\"0\" width=\"29.75\" height=\"60\" fill=\"#FFFFFF\"/><rect x=\"56.7\" y=\"0\" width=\"33.35\" height=\"60\" fill=\"#EF4135\"/></svg>","regime":"Революция, Первая республика и империя","ideo":["Демократия","Либерализм","Национализм","Монархия"],"y0":1794,"y1":1815,"name":"Триколор 1794 года (полосы 30:33:37)","src":"реальный","note":"Флаг, утверждённый Конвентом 15 февраля 1794: синий у древка, белый, красный, ширина полос 30:33:37. Использовался и при Наполеоне (орёл только на знамёнах). Уверенность 5/5"},{"id":"FR-1814","w":90,"svg":"<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 90 60\"><rect x=\"0\" y=\"0\" width=\"90\" height=\"60\" fill=\"#FFFFFF\"/></svg>","regime":"Реставрация Бурбонов","ideo":["Монархия","Консерватизм"],"y0":1814,"y1":1830,"name":"Белый флаг Бурбонов","src":"реальный","note":"Белое знамя Реставрации (1814–15, 1815–30). Рамка по контуру добавлена не была; чисто белый. Уверенность 5/5"},{"id":"FR-1946","w":90,"svg":"<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 90 60\"><rect x=\"0\" y=\"0\" width=\"30.05\" height=\"60\" fill=\"#0055A4\"/><rect x=\"30\" y=\"0\" width=\"30.05\" height=\"60\" fill=\"#FFFFFF\"/><rect x=\"60\" y=\"0\" width=\"30.05\" height=\"60\" fill=\"#EF4135\"/></svg>","regime":"Четвёртая и Пятая республики","ideo":["Монархия","Либерализм","Консерватизм","Национализм","Демократия","Социал-демократия","Нацизм/фашизм","Однопартийное","Хунта"],"y0":1830,"y1":0,"name":"Триколор Франции (нынешний)","src":"реальный","note":"Нынешний государственный флаг (Конституция 1946 и 1958), равные полосы. Уверенность 5/5 Объединено одинаковых флагов: FR-1830, FR-1870, FR-1940."},{"id":"FR-1871","w":90,"svg":"<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 90 60\"><rect x=\"0\" y=\"0\" width=\"90\" height=\"60\" fill=\"#D40000\"/></svg>","regime":"Парижская коммуна","ideo":["Социализм","Прямая демократия","Республика советов","Коммунизм","Анархизм"],"y0":1871,"y1":1871,"name":"Красное знамя Парижской коммуны","src":"реальный","note":"Простое красное знамя над ратушей 18 марта – 28 мая 1871 вместо триколора. Уверенность 5/5"},{"id":"FR-1883","w":90,"svg":"<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 90 60\"><rect x=\"0\" y=\"0\" width=\"90\" height=\"60\" fill=\"#111111\"/></svg>","regime":"Анархисты Франции","ideo":["Анархизм"],"y0":1883,"y1":0,"name":"Чёрное знамя","src":"движение","note":"Чёрное знамя, поднятое Луизой Мишель на демонстрации безработных в Париже 9 марта 1883, символ анархистов. Уверенность 5/5"},{"id":"FR-1940b","w":90,"svg":"<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 90 60\"><rect x=\"0\" y=\"0\" width=\"30.05\" height=\"60\" fill=\"#0055A4\"/><rect x=\"30\" y=\"0\" width=\"30.05\" height=\"60\" fill=\"#FFFFFF\"/><rect x=\"60\" y=\"0\" width=\"30.05\" height=\"60\" fill=\"#EF4135\"/><rect x=\"43.4\" y=\"21\" width=\"3.2\" height=\"18\" fill=\"#EF4135\"/><rect x=\"40\" y=\"24.8\" width=\"10\" height=\"3\" fill=\"#EF4135\"/><rect x=\"38\" y=\"30.2\" width=\"14\" height=\"3\" fill=\"#EF4135\"/></svg>","regime":"Свободная Франция","ideo":["Демократия","Национализм"],"y0":1940,"y1":1944,"name":"Триколор с лотарингским крестом","src":"реальный","note":"Флаг Сражающейся (Свободной) Франции де Голля: триколор, красный лотарингский крест на белой полосе. Уверенность 4/5"}],"GB":[{"id":"GB-1500","w":100,"svg":"<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 100 60\"><rect x=\"0\" y=\"0\" width=\"100\" height=\"60\" fill=\"#FFFFFF\"/><rect x=\"0\" y=\"24\" width=\"100\" height=\"12\" fill=\"#CE1124\"/><rect x=\"44\" y=\"0\" width=\"12\" height=\"60\" fill=\"#CE1124\"/></svg>","regime":"Королевство Англия","ideo":["Монархия","Консерватизм","Национализм","Демократия","Либерализм"],"y0":1500,"y1":1707,"name":"Крест святого Георгия","src":"реальный","note":"Красный крест на белом, флаг Англии. В 1649–60 республика Содружество тоже использовала его. Уверенность 5/5 Объединено одинаковых флагов: GB-1649."},{"id":"GB-1500s","w":100,"svg":"<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 100 60\"><rect x=\"0\" y=\"0\" width=\"100\" height=\"60\" fill=\"#005EB8\"/><g transform=\"translate(50 30)\"><rect x=\"-60.31\" y=\"-6\" width=\"120.62\" height=\"12\" fill=\"#FFFFFF\" transform=\"rotate(30.96)\"/><rect x=\"-60.31\" y=\"-6\" width=\"120.62\" height=\"12\" fill=\"#FFFFFF\" transform=\"rotate(-30.96)\"/></g></svg>","regime":"Королевство Шотландия","ideo":["Монархия","Консерватизм","Национализм"],"y0":1500,"y1":1707,"name":"Андреевский крест (флаг Шотландии)","src":"реальный","note":"Белый косой крест на синем; оттенок синего у шотландского флага менялся. Уверенность 5/5"},{"id":"GB-1606","w":100,"svg":"<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 100 60\"><rect x=\"0\" y=\"0\" width=\"100\" height=\"60\" fill=\"#012169\"/><polygon points=\"53.09,24.86 11.66,0 0,0 0,7 46.91,35.14\" fill=\"#FFFFFF\"/><polygon points=\"53.09,35.14 100,7 100,0 88.34,0 46.91,24.86\" fill=\"#FFFFFF\"/><polygon points=\"46.91,35.14 88.34,60 100,60 100,53 53.0