=\"1.9\" fill=\"#D2142C\"/></g></svg>","regime":"Молдавское княжество","ideo":["Монархия","Консерватизм","Национализм"],"y0":1500,"y1":1859,"name":"Красное знамя с головой тура","src":"реальный","note":"Красное знамя с золотой головой тура (звезда между рогов, розетка, полумесяц), символ Молдавского княжества (знамя Стефана Великого и преемников); фигуры упрощены. Уверенность 3/5."},{"id":"MD-1917","w":90,"svg":"<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 90 60\"><rect x=\"0\" y=\"0\" width=\"90\" height=\"20.05\" fill=\"#FFFFFF\"/><rect x=\"0\" y=\"20\" width=\"90\" height=\"20.05\" fill=\"#0039A6\"/><rect x=\"0\" y=\"40\" width=\"90\" height=\"20.05\" fill=\"#D52B1E\"/></svg>","regime":"Временное правительство / Российская республика","ideo":["Демократия","Либерализм","Социал-демократия"],"y0":1917,"y1":1917,"name":"Триколор Временного правительства","src":"реальный","note":"Временное правительство формально не вводило нового флага, использовало бело-сине-красный триколор (и красные флаги революции). Уверенность 4/5."},{"id":"MD-1917","w":77,"svg":"<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 77 60\"><rect x=\"0\" y=\"0\" width=\"77\" height=\"20.05\" fill=\"#0046AE\"/><rect x=\"0\" y=\"20\" width=\"77\" height=\"20.05\" fill=\"#FFD200\"/><rect x=\"0\" y=\"40\" width=\"77\" height=\"20.05\" fill=\"#CC092F\"/><path d=\"M32.5,22 L44.5,22 L44.5,29.2 Q44.5,35.6 38.5,38 Q32.5,35.6 32.5,29.2 Z\" fill=\"#0046AE\" stroke=\"#B98B2E\" stroke-width=\"0.6\"/><g transform=\"translate(38.5 30) scale(0.42)\" fill=\"#F2C230\"><polygon points=\"-4.4,-4 4.4,-4 3.8,3 0,10 -3.8,3\"/><path d=\"M-4.2,-3.6 C-9.6,-3 -12,-9 -9,-14.6 C-9,-10.4 -6.4,-8.4 -3.4,-8 Z\"/><path d=\"M4.2,-3.6 C9.6,-3 12,-9 9,-14.6 C9,-10.4 6.4,-8.4 3.4,-8 Z\"/><polygon points=\"-4.4,-2 -8.6,-0.6 -8,1.6 -4,1\"/><polygon points=\"4.4,-2 8.6,-0.6 8,1.6 4,1\"/><polygon points=\"0,-12 0.49,-10.48 2.09,-10.48 0.8,-9.54 1.29,-8.02 0,-8.96 -1.29,-8.02 -0.8,-9.54 -2.09,-10.48 -0.49,-10.48\" fill=\"#F2C230\"/></g></svg>","regime":"Молдавская Демократическая Республика","ideo":["Демократия","Национализм","Социал-демократия"],"y0":1917,"y1":1918,"name":"Горизонтальный триколор МДР","src":"реальный","note":"Горизонтальный сине-жёлто-красный флаг (9:7) с гербом на жёлтой полосе и золотой каймой; надпись на синей полосе, кайма опущены, герб упрощён. Уверенность 4/5."},{"id":"MD-1941","w":90,"svg":"<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 90 60\"><rect x=\"0\" y=\"0\" width=\"30.05\" height=\"60\" fill=\"#002B7F\"/><rect x=\"30\" y=\"0\" width=\"30.05\" height=\"60\" fill=\"#FCD116\"/><rect x=\"60\" y=\"0\" width=\"30.05\" height=\"60\" fill=\"#CE1126\"/></svg>","regime":"Королевство Румыния при Антонеску (Бессарабия)","ideo":["Монархия","Консерватизм","Национализм","Нацизм/фашизм","Хунта"],"y0":1918,"y1":1944,"name":"Румынский триколор военного времени","src":"реальный","note":"Вместо знаков Железной гвардии и нацистских символов: государственный флаг Румынии (сине-жёлто-красный), под которым действовала администрация Антонеску в Бессарабии. Уверенность 4/5. Объединено одинаковых флагов: MD-1918."},{"id":"MD-1940","w":120,"svg":"<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 120 60\"><rect x=\"0\" y=\"0\" width=\"120\" height=\"60\" fill=\"#CD0000\"/><g transform=\"translate(18 19) scale(0.21)\" fill=\"#FFD900\"><g transform=\"translate(-50 -50)\"><polygon points=\"22.74,28.26 28.26,22.74 70.68,65.17 65.17,70.68\"/><polygon points=\"9.94,31.16 19.84,41.06 33.99,26.91 42.75,13.05 37.95,8.25 24.09,17.01\"/><polygon points=\"35.78,91.35 37.41,91.92 39.19,92.47 40.99,92.92 42.81,93.28 44.65,93.55 46.49,93.74 48.34,93.83 50.19,93.83 52.04,93.74 53.88,93.56 55.71,93.29 57.51,92.93 59.3,92.49 61.06,91.96 62.79,91.34 64.49,90.64 66.15,89.85 67.77,88.99 69.34,88.05 70.86,87.04 72.33,85.95 73.74,84.79 75.09,83.57 76.38,82.28 77.61,80.93 78.76,79.53 79.84,78.07 80.85,76.56 81.78,75.01 82.64,73.41 83.41,71.78 84.1,70.11 84.71,68.41 85.23,66.69 85.67,64.9