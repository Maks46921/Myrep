7\" height=\"2.7\" fill=\"#F2C230\"/><rect x=\"48.45\" y=\"40.05\" width=\"2.7\" height=\"2.7\" fill=\"#F2C230\"/><g transform=\"translate(45 16.95) scale(0.9)\" fill=\"#E0B93A\"><polygon points=\"-6,4 -6,-3 -3,0 0,-5 3,0 6,-3 6,4\"/><rect x=\"-6\" y=\"4.5\" width=\"12\" height=\"1.8\"/></g></svg>","regime":"Конституционная монархия Португалии","ideo":["Монархия","Либерализм","Консерватизм","Национализм"],"y0":1830,"y1":1910,"name":"Сине-белый флаг конституционной монархии","src":"реальный","note":"Вертикальный сине-белый (синий у древка) с королевским гербом на границе полос; соотношение полос в источниках расходится (1:1 или 1:3), взято 1:1. Уверенность 3/5"},{"id":"PT-1911","w":90,"svg":"<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 90 60\"><rect x=\"0\" y=\"0\" width=\"36.05\" height=\"60\" fill=\"#006600\"/><rect x=\"36\" y=\"0\" width=\"54.05\" height=\"60\" fill=\"#FF0000\"/><circle cx=\"36\" cy=\"30\" r=\"11\" fill=\"none\" stroke=\"#FFE000\" stroke-width=\"1.5\"/><path d=\"M30.5,30 A5.5,11 0 1 0 41.5,30 A5.5,11 0 1 0 30.5,30 Z\" fill=\"none\" stroke=\"#FFE000\" stroke-width=\"1.2\"/><path d=\"M25,30 A11,3.8499999999999996 0 1 0 47,30 A11,3.8499999999999996 0 1 0 25,30 Z\" fill=\"none\" stroke=\"#FFE000\" stroke-width=\"1.2\"/><line x1=\"25\" y1=\"30\" x2=\"47\" y2=\"30\" stroke=\"#FFE000\" stroke-width=\"1.2\"/><path d=\"M29.35,21.93 L42.65,21.93 L42.65,29.19 Q42.65,35.65 36,38.08 Q29.35,35.65 29.35,29.19 Z\" fill=\"#D6202C\" stroke=\"#FFFFFF\" stroke-width=\"0.47\"/><path d=\"M31.61,24 L40.39,24 L40.39,29.23 Q40.39,33.88 36,35.62 Q31.61,33.88 31.61,29.23 Z\" fill=\"#FFFFFF\"/><rect x=\"34.86\" y=\"28.37\" width=\"2.28\" height=\"2.51\" fill=\"#1B3F94\"/><rect x=\"34.86\" y=\"25.14\" width=\"2.28\" height=\"2.51\" fill=\"#1B3F94\"/><rect x=\"34.86\" y=\"31.6\" width=\"2.28\" height=\"2.51\" fill=\"#1B3F94\"/><rect x=\"31.82\" y=\"28.37\" width=\"2.28\" height=\"2.51\" fill=\"#1B3F94\"/><rect x=\"37.9\" y=\"28.37\" width=\"2.28\" height=\"2.51\" fi