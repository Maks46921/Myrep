www.w3.org/2000/svg\" viewBox=\"0 0 90 60\"><rect x=\"0\" y=\"0\" width=\"90\" height=\"6.72\" fill=\"#0D5EAF\"/><rect x=\"0\" y=\"6.67\" width=\"90\" height=\"6.72\" fill=\"#FFFFFF\"/><rect x=\"0\" y=\"13.33\" width=\"90\" height=\"6.72\" fill=\"#0D5EAF\"/><rect x=\"0\" y=\"20\" width=\"90\" height=\"6.72\" fill=\"#FFFFFF\"/><rect x=\"0\" y=\"26.67\" width=\"90\" height=\"6.72\" fill=\"#0D5EAF\"/><rect x=\"0\" y=\"33.33\" width=\"90\" height=\"6.72\" fill=\"#FFFFFF\"/><rect x=\"0\" y=\"40\" width=\"90\" height=\"6.72\" fill=\"#0D5EAF\"/><rect x=\"0\" y=\"46.67\" width=\"90\" height=\"6.72\" fill=\"#FFFFFF\"/><rect x=\"0\" y=\"53.33\" width=\"90\" height=\"6.72\" fill=\"#0D5EAF\"/><rect x=\"0\" y=\"0\" width=\"33.33\" height=\"33.33\" fill=\"#0D5EAF\"/><rect x=\"0\" y=\"13.33\" width=\"33.33\" height=\"6.67\" fill=\"#FFFFFF\"/><rect x=\"13.33\" y=\"0\" width=\"6.67\" height=\"33.33\" fill=\"#FFFFFF\"/></svg>","regime":"Третья Греческая республика","ideo":["Монархия","Консерватизм","Либерализм","Национализм","Демократия","Социал-демократия","Нацизм/фашизм","Однопартийное"],"y0":1863,"y1":0,"name":"Нынешний флаг Греции","src":"реальный","note":"Девять полос (по слогам «Ελευθερία ή Θάνατος»), закреплён в 1978 г.; в 1975–78 гг. действовал крестовый флаг. Уверенность 5/5 Объединено одинаковых флагов: GR-1863, GR-1924, GR-1935, GR-1936, GR-1941."},{"id":"GR-1926","w":90,"svg":"<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 90 60\"><rect x=\"0\" y=\"0\" width=\"90\" height=\"60\" fill=\"#FFD400\"/><g transform=\"translate(45 35) scale(0.5)\"><g transform=\"translate(-50 -50)\"><g><g fill=\"#000\" stroke=\"#000\" stroke-width=\"0.7\" stroke-linejoin=\"round\"><g transform=\"translate(0 13) scale(1 0.88)\"><polygon points=\"46,38 41,30 33,22 23,15 13,9 3,4 10.91,15.05 1,17 12.24,25.75 4,30 16.99,35.13 10,41 23.47,42.3 18,50 30.96,46.95 28,56 35,55 40,47 43,41\"/></g><polygon points=\"50,36 45.5,40 43.5,47 43,56 44,63 46.5,68 50,70\"/><polygon points=\"45,64 38,79 39