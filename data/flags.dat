"regime": "Народная Социалистическая Республика Албания",
"ideo": ["Социализм", "Коммунизм", "Однопартийное"],
"y0": 1944,
"y1": 1992,
"name": "Флаг НСРА",
"src": "реальный",
"note": "Красное полотнище 5:7 с чёрным орлом и красной звездой в золотой кайме над ним (с 1944 г. у Демократического правительства, закреплён в 1946; уверенность 5/5)"
}],
