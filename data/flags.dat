\" width=\"90\" height=\"20.05\" fill=\"#CD2A3E\"/><rect x=\"0\" y=\"40\" width=\"90\" height=\"20.05\" fill=\"#436F4D\"/><path fill-rule=\"evenodd\" d=\"M0,20 H90 V40 H0 Z M45,22 a8,8 0 1,0 0.01,0 Z\" fill=\"#FFFFFF\"/></svg>","regime":"Венгерская революция 1956","ideo":["Демократия","Национализм","Либерализм"],"y0":1956,"y1":1956,"name":"Флаг с дырой","src":"движение","note":"Триколор с вырезанным гербом; дыра показана сквозной (в галерее виден фон). Символ революции. Уверенность 5/5."},{"id":"HU-1989","w":120,"svg":"<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 120 60\"><rect x=\"0\" y=\"0\" width=\"120\" height=\"20.05\" fill=\"#CD2A3E\"/><rect x=\"0\" y=\"20\" width=\"120\" height=\"20.05\" fill=\"#FFFFFF\"/><rect x=\"0\" y=\"40\" width=\"120\" height=\"20.05\" fill=\"#436F4D\"/></svg>","regime":"Республика Венгрия","ideo":["Демократия","Социал-демократия","Либерализм","Консерватизм","Национализм"],"y0":1989,"y1":0,"name":"Современный флаг Венгрии","src":"реальный","note":"Красно-бело-зелёный горизонтальный триколор, 1:2. Уверенность 5/5."}],"IE":[{"id":"IE-1798","w":120,"svg":"<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 120 60\"><rect x=\"0\" y=\"0\" width=\"120\" height=\"60\" fill=\"#169B62\"/><g transform=\"translate(60 30) scale(0.44)\"><g transform=\"translate(-50 -50)\"><g fill=\"none\" stroke=\"#FFD900\" stroke-width=\"8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M20,92 L20,30 C34,8 74,12 88,48 L88,64 C80,80 46,90 20,92\"/></g><g fill=\"#FFD900\"><rect x=\"12\" y=\"84\" width=\"16\" height=\"10\" rx=\"2\"/><circle cx=\"20\" cy=\"22\" r=\"6.5\"/></g><g stroke=\"#FFD900\" stroke-width=\"1.6\" stroke-linecap=\"round\"><line x1=\"28\" y1=\"25\" x2=\"28\" y2=\"88\"/><line x1=\"36.4\" y1=\"18\" x2=\"36.4\" y2=\"86\"/><line x1=\"44.8\" y1=\"16.5\" x2=\"44.8\" y2=\"84\"/><line x1=\"53.2\" y1=\"19\" x2=\"53.2\" y2=\"80\"/><line x1=\"61.6\" y1=\"25\" x2=\"61.6\" y2=\"76\"/><line x1=\"70\" y1=\"33\" x2=\"70\" y2=\"72\"/><line x1=\"78.4\" y1=\"43\" x2=\"78.4\" y2=\"67\"/></g></g></g></svg>","regime":"Ирландские республиканцы (Объединённые ирландцы, фении, Пасхальное восстание)","ideo":["Национализм","Демократия","Либерализм"],"y0":1798,"y1":1922,"name":"Зелёное знамя с золотой арфой","src":"движение","note":"Зелёное знамя с арфой без короны: Объединённые ирландцы 1798, фении, флаг у почты в Дублине в 1916 (надпись «Irish Republic» на нём не рисуется). Арфа сильно упрощена. Уверенность 3/5"},{"id":"IE-1914","w":120,"svg":"<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 120 60\"><rect x=\"0\" y=\"0\" width=\"120\" height=\"60\" fill=\"#00335E\"/><g transform=\"translate(12 0) scale(0.9)\"><g fill=\"#FFD900\"><polygon points=\"26,38 46,34 58,30 60,32 50,38 30,44\"/><polygon points=\"56,30 60,30 74,50 66,52\"/><polygon points=\"30,44 46,44 52,50 24,50\"/><polygon points=\"60,32 74,12 78,14 66,34\"/><polygon points=\"40,36 44,36 44,50 40,50\"/></g><polygon points=\"20,4.8 20.72,7.01 23.04,7.01 21.16,8.38 21.88,10.59 20,9.22 18.12,10.59 18.84,8.38 16.96,7.01 19.28,7.01\" fill=\"#FFD900\"/><polygon points=\"32,2.8 32.72,5.01 35.04,5.01 33.16,6.38 33.88,8.59 32,7.22 30.12,8.59 30.84,6.38 28.96,5.01 31.28,5.01\" fill=\"#FFD900\"/><polygon points=\"44,5.8 44.72,8.01 47.04,8.01 45.16,9.38 45.88,11.59 44,10.22 42.12,11.59 42.84,9.38 40.96,8.01 43.28,8.01\" fill=\"#FFD900\"/><polygon points=\"56,8.8 56.72,11.01 59.04,11.01 57.16,12.38 57.88,14.59 56,13.22 54.12,14.59 54.84,12.38 52.96,11.01 55.28,11.01\" fill=\"#FFD900\"/><polygon points=\"70,12.8 70.72,15.01 73.04,15.01 71.16,16.38 71.88,18.59 70,17.22 68.12,18.59 68.84,16.38 66.96,15.01 69.28,15.01\" fill=\"#FFD900\"/><polygon points=\"76,20.8 76.72,23.01 79.04,23.01 77.16,24.38 77.88,26.59 76,25.22 74.12,26.59 74.84,24.38 72.96,23.01 75.28,23.01\" fill=\"#FFD900\"/><polygon points=\"82,30.8 82.72,33.01 85.04,33.01 83.16,34.38 83.88,36.59 82,35.22 80.12,36.59 80.84,34.38 78.96,33.01 81.28,33.01\" fill=\"#FFD900\"/></g></svg>","regime":"Ирландская гражданская армия (рабочее движение)","ideo":["Социализм","Коммунизм"],"y0":1914,"y1":0,"name":"Звёздный плуг","src":"движение","note":"Знамя ирландских социалистов и Ирландской гражданской армии: плуг и семь звёзд Большой Медведицы. Плуг упрощён. Уверенность 3/5"},{"id":"IE-1919","w":120,"svg":"<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 120 60\"><rect x=\"0\" y=\"0\" width=\"40.05\" height=\"60\" fill=\"#169B62\"/><rect x=\"40\" y=\"0\" width=\"40.05\" height=\"60\" fill=\"#FFFFFF\"/><rect x=\"80\" y=\"0\" width=\"40.05\" height=\"60\" fill=\"#FF883E\"/></svg>","regime":"Ирландская республика, Свободное государство и Ирландия","ideo":["Демократия","Социал-демократия","Либерализм","Консерватизм","Национализм"],"y0":1919,"y1":0,"name":"Ирландский триколор (зелёный, белый, оранжевый)","src":"реальный","note":"Флаг, поднятый в 1848 Т. Ф. Мигером; флаг Ирландской республики 1919–22, Свободного государства (доминиона 1922–37) и нынешней Ирландии (конституция 1937), пропорции 1:2. Уверенность 5/5"}],"IT":[{"id":"IT-1500","w":90,"svg":"<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 90 60\"><rect x=\"0\" y=\"0\" width=\"90\" height=\"60\" fill=\"#FFFFFF\"/><rect x=\"0\" y=\"24\" width=\"90\" height=\"12\" fill=\"#CE1126\"/><rect x=\"39\" y=\"0\" width=\"12\" height=\"60\" fill=\"#CE1126\"/></svg>","regime":"Республика Генуя","ideo":["Консерватизм","Плутократия/Олигархия"],"y0":1500,"y1":1797,"name":"Крест святого Георгия Генуи","src":"реальный","note":"Красный крест на белом, флаг Генуэзской республики; позднее версия с гербовыми щитодержателями не рисуется. Уверенность 5/5"},{"id":"IT-1500s","w":90,"svg":"<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 90 60\"><rect x=\"0\" y=\"0\" width=\"90\" height=\"60\" fill=\"#CE1126\"/><rect x=\"17.1\" y=\"25\" width=\"55.8\" height=\"10\" fill=\"#FFFFFF\"/><rect x=\"40\" y=\"11.4\" width=\"10\" height=\"37.2\" fill=\"#FFFFFF\"/></svg>","regime":"Герцогство Савойя","ideo":["Монархия","Консерватизм"],"y0":1500,"y1":1720,"name":"Крест Савойи (белый на красном)","src":"реальный","note":"Знамя Савойского дома. Простой крест на красном; пропорции креста упрощены. Уверенность 3/5"},{"id":"IT-1808","w":90,"svg":"<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 90 60\"><rect x=\"0\" y=\"0\" width=\"45.05\" height=\"60\" fill=\"#F2C500\"/><rect x=\"45\" y=\"0\" width=\"45.05\" height=\"60\" fill=\"#FFFFFF\"/><g transform=\"translate(67.5 30)\"><line x1=\"-8\" y1=\"9\" x2=\"8\" y2=\"-7\" stroke=\"#C9A227\" stroke-width=\"2.4\"/><line x1=\"8\" y1=\"9\" x2=\"-8\" y2=\"-7\" stroke=\"#8D8D8D\" stroke-width=\"2.4\"/><circle cx=\"-8\" cy=\"-7.6\" r=\"2.5\" fill=\"#C9A227\"/><circle cx=\"8\" cy=\"-7.6\" r=\"2.5\" fill=\"#8D8D8D\"/><rect x=\"-11\" y=\"7.5\" width=\"5\" height=\"3\" fill=\"#C9A227\"/><rect x=\"6\" y=\"7.5\" width=\"5\" height=\"3\" fill=\"#8D8D8D\"/><g transform=\"translate(0 -1.5) scale(1.3)\"><polygon points=\"-4,2 4,2 3,-3 -3,-3\" fill=\"#B8860B\"/><polygon points=\"-3,-3 3,-3 2.2,-6.4 -2.2,-6.4\" fill=\"#C9A227\"/><polygon points=\"-2.2,-6.4 2.2,-6.4 0,-10.5\" fill=\"#E0B93A\"/></g></g></svg>","regime":"Папская область","ideo":["Теократия","Монархия","Консерватизм"],"y0":1808,"y1":1870,"name":"Жёлто-белый флаг Папской области","src":"реальный","note":"Жёлтый и белый (с 1808), на белой части герб Святого Престола: тиара и скрещённые ключи, сильно упрощены. До 1808 флаги были красно-жёлтыми. Уверенность 4/5"},{"id":"IT-1797","w":90,"svg":"<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 90 60\"><rect x=\"0\" y=\"0\" width=\"90\" height=\"20.05\" fill=\"#CE2B37\"/><rect x=\"0\" y=\"20\" width=\"90\" height=\"20.05\" fill=\"#FFFFFF\"/><rect x=\"0\" y=\"40\" width=\"90\" height=\"20.05\" fill=\"#009246\"/><circle cx=\"45\" cy=\"30\" r=\"10.5\" fill=\"none\" stroke=\"#2E7D32\" stroke-width=\"2\"/><line x1=\"40.5\" y1=\"38\" x2=\"38.25\" y2=\"22\" stroke=\"#7A4A1E\" stroke-width=\"1.2\"/><line x1=\"43.5\" y1=\"38\" x2=\"42.75\" y2=\"22\" stroke=\"#7A4A1E\" stroke-width=\"1.2\"/><line x1=\"46.5\" y1=\"38\" x2=\"47.25\" y2=\"22\" stroke=\"#7A4A1E\" stroke-width=\"1.2\"/><line x1=\"49.5\" y1=\"38\" x2=\"51.75\" y2=\"22\" stroke=\"#7A4A1E\" stroke-width=\"1.2\"/><rect x=\"41\" y=\"33\" width=\"8\" height=\"5\" fill=\"#7A4A1E\"/></svg>","regime":"Циспаданская республика","ideo":["Демократия","Либерализм","Национализм"],"y0":1797,"y1":1797,"name":"Первый итальянский триколор (красный-белый-зелёный)","src":"реальный","note":"Горизонтальный триколор Реджо-Эмилии 1797: красный, белый, зелёный; в центре колчан и трофей с 4 стрелами (4 провинции) в лавровом венке — упрощены. Уверенность 4/5"},{"id":"IT-1802","w":90,"svg":"<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 90 60\"><rect x=\"0\" y=\"0\" width=\"90\" height=\"60\" fill=\"#CE2B37\"/><polygon points=\"45,4 75,30 45,56 15,30\" fill=\"#FFFFFF\"/><polygon points=\"35,20 55,20 55,40 35,40\" fill=\"#009246\"/></svg>","regime":"Итальянская республика (Наполеон)","ideo":["Демократия","Либерализм","Национализм"],"y0":1802,"y1":1805,"name":"Красное полотнище с белым ромбом и зелёным квадратом","src":"реальный","note":"Флаг президента Бонапарта: красный фон, белый ромб, в нём зелёный квадрат. Уверенность 4/5"},{"id":"IT-1848","w":90,"svg":"<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 90 60\"><rect x=\"0\" y=\"0\" width=\"30.05\" height=\"60\" fill=\"#008C45\"/><rect x=\"30\" y=\"0\" width=\"30.05\" height=\"60\" fill=\"#F4F5F0\"/><rect x=\"60\" y=\"0\" width=\"30.05\" height=\"60\" fill=\"#CD212A\"/><path d=\"M37.5,23.5 L52.5,23.5 L52.5,32.05 Q52.5,39.65 45,42.5 Q37.5,39.65 37.5,32.05 Z\" fill=\"#CD212A\" stroke=\"#1B3F94\" stroke-width=\"1.4\"/><rect x=\"38.5\" y=\"29.02\" width=\"13\" height=\"3.4\" fill=\"#FFFFFF\"/><rect x=\"43.3\" y=\"24.5\" width=\"3.4\" height=\"16.15\" fill=\"#FFFFFF\"/><g transform=\"translate(45 15.5) scale(1)\" fill=\"#C9A227\"><polygon points=\"-6,4 -6,-3 -3,0 0,-5 3,0 6,-3 6,4\"/><rect x=\"-6\" y=\"4.5\" width=\"12\" height=\"1.8\"/></g></svg>","regime":"Королевство Сардиния и Королевство Италия","ideo":["Монархия","Консерватизм","Национализм","Либерализм","Нацизм/фашизм"],"y0":1848,"y1":1946,"name":"Триколор с гербом Савойского дома","src":"реальный","note":"Флаг с савойским щитом (белый крест на красном с синей каймой) и короной; для фашистского периода 1922–43 флаг остался тем же (государственный, без партийных символов — фасций на нём не рисуем). Уверенность 4/5"},{"id":"IT-1943","w":90,"svg":"<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 90 60\"><rect x=\"0\" y=\"0\" width=\"30.05\" height=\"60\" fill=\"#008C45\"/><rect x=\"30\" y=\"0\" width=\"30.05\" height=\"60\" fill=\"#F4F5F0\"/><rect x=\"60\" y=\"0\" width=\"30.05\" height=\"60\" fill=\"#CD212A\"/></svg>","regime":"Итальянская социальная республика (Сало)","ideo":["Нацизм/фашизм","Однопартийное","Национализм"],"y0":1943,"y1":1945,"name":"Государственный триколор РСИ","src":"реальный","note":"Вместо военного флага с орлом и фасцией — государственный триколор без эмблемы (такой же, как у нынешней республики). Уверенность 4/5"},{"id":"IT-1946","w":90,"svg":"<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 90 60\"><rect x=\"0\" y=\"0\" width=\"30.05\" height=\"60\" fill=\"#009246\"/><rect x=\"30\" y=\"0\" width=\"30.05\" height=\"60\" fill=\"#F1F2F1\"/><rect x=\"60\" y=\"0\" width=\"30.05\" height=\"60\" fill=\"#CE2B37\"/></svg>","regime":"Итальянская Республика","ideo":["Демократия","Социал-демократия","Либерализм","Консерватизм"],"y0":1946,"y1":0,"name":"Триколор Италии (нынешний)","src":"реальный","note":"Зелёный, белый, красный; с 1 января 1948 по конституции. Уверенность 5/5"},{"id":"IT-1874","w":90,"svg":"<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 90 60\"><rect x=\"0\" y=\"0\" width=\"90\" height=\"60\" fill=\"#111111\"/></svg>","regime":"Анархисты Италии","ideo":["Анархизм"],"y0":1874,"y1":0,"name":"Чёрное знамя","src":"движение","note":"Чёрное знамя итальянских анархистов (Бакунин, Мала