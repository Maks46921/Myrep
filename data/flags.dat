FF\"/><rect x=\"0\" y=\"40\" width=\"120\" height=\"20.05\" fill=\"#C8102E\"/></svg>","regime":"СР Югославия / Сербия и Черногория","ideo":["Федерация","Конфедерация","Национализм","Социализм","Демократия"],"y0":1992,"y1":2006,"name":"Флаг СРЮ","src":"реальный","note":"Сине-бело-красный триколор 1:2 без звезды (уверенность 5/5)"},{"id":"ME-1993","w":120,"svg":"<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 120 60\"><rect x=\"0\" y=\"0\" width=\"120\" height=\"20.05\" fill=\"#C8102E\"/><rect x=\"0\" y=\"20\" width=\"120\" height=\"20.05\" fill=\"#4C8FD9\"/><rect x=\"0\" y=\"40\" width=\"120\" height=\"20.05\" fill=\"#FFFFFF\"/></svg>","regime":"Республика Черногория (в составе СРЮ)","ideo":["Демократия","Социал-демократия","Национализм"],"y0":1993,"y1":2004,"name":"Красно-голубо-белый триколор","src":"реальный","note":"Красный, светло-голубой («плавэтна») и белый (уверенность 4/5)"},{"id":"ME-2004","w":120,"svg":"<svg width=\"1200\" height=\"600\" xmlns=\"http://www.w3.org/2000/svg\" xmlns:c2pa=\"http://c2pa.org/manifest\"><rect x=\"15\" y=\"15\" width=\"1170\" height=\"570\" fill=\"#E30000\" stroke=\"#FFC000\" stroke-width=\"30\"/><g transform=\"matrix(0.64394391, 0, 0, 0.64394391, 426.45721436, 99.7333374)\"><path d=\"M314.9176 158.112c-6.506 3.595-10.22 2.794-9.953 5.457.267 2.664 6.1 4.66 6.1 4.66s-5.971 6.388-10.617 9.318c-4.64 2.928-10.089 4.789-10.089 4.789s-1.854.269-.793 3.196c1.064 2.928 2.921 4.922 4.378 5.723 1.461.797 2.26 1.065 2.26 1.065s-8.096 8.651-11.678 11.446c-3.585 2.795-5.575 3.724-8.493 4.925-2.921 1.198-1.457 5.987-.796 8.121.66 2.124 3.182 5.054 4.646 5.454 1.454.401 1.989 1.464.132 4.393-1.39 2.184-6.021 7.995-8.231 11.2l-.135.069c-2.193-3.183-6.888-9.068-8.284-11.269-1.858-2.929-1.327-3.992.133-4.393 1.461-.399 3.983-3.329 4.647-5.454.658-2.134 2.122-6.923-.802-8.121-2.917-1.201-4.908-2.13-8.49-4.925-3.584-2.797-11.679-11.446-11.679-11.446s.796-.268 2.255-1.065c1.463-.8 3.319-2.794 4.382-5.723 1.059-2.927-.798-3.196-.798-3.196s-5.4