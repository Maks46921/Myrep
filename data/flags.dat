8313E\"/><rect x=\"5.56\" y=\"10.9\" width=\"2.2\" height=\"2.2\" fill=\"#C8313E\"/><rect x=\"0.6\" y=\"11.3\" width=\"1.4\" height=\"1.4\" fill=\"#C8313E\"/><rect x=\"11.33\" y=\"11.3\" width=\"1.4\" height=\"1.4\" fill=\"#C8313E\"/><rect x=\"5.56\" y=\"22.9\" width=\"2.2\" height=\"2.2\" fill=\"#C8313E\"/><rect x=\"0.6\" y=\"23.3\" width=\"1.4\" height=\"1.4\" fill=\"#C8313E\"/><rect x=\"11.33\" y=\"23.3\" width=\"1.4\" height=\"1.4\" fill=\"#C8313E\"/><rect x=\"5.56\" y=\"34.9\" width=\"2.2\" height=\"2.2\" fill=\"#C8313E\"/><rect x=\"0.6\" y=\"35.3\" width=\"1.4\" height=\"1.4\" fill=\"#C8313E\"/><rect x=\"11.33\" y=\"35.3\" width=\"1.4\" height=\"1.4\" fill=\"#C8313E\"/><rect x=\"5.56\" y=\"46.9\" width=\"2.2\" height=\"2.2\" fill=\"#C8313E\"/><rect x=\"0.6\" y=\"47.3\" width=\"1.4\" height=\"1.4\" fill=\"#C8313E\"/><rect x=\"11.33\" y=\"47.3\" width=\"1.4\" height=\"1.4\" fill=\"#C8313E\"/></svg>","regime":"Республика Беларусь","ideo":["Консерватизм","Социализм","Национализм"],"y0":1995,"y1":0,"name":"Красно-зелёный флаг Беларуси","src":"реальный","note":"Флаг с 1995 (в современном виде с 2012): красный и зелёный 2:1, красный орнамент на белой полосе у древка; орнамент упрощён. Уверенность 4/5."}],"CH":[{"id":"CH-1848","w":60,"svg":"<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 60 60\"><rect x=\"0\" y=\"0\" width=\"60\" height=\"60\" fill=\"#DA291C\"/><rect x=\"24.38\" y=\"11.25\" width=\"11.25\" height=\"37.5\" fill=\"#FFFFFF\"/><rect x=\"11.25\" y=\"24.38\" width=\"37.5\" height=\"11.25\" fill=\"#FFFFFF\"/></svg>","regime":"Швейцарская Конфедерация (федеративное государство)","ideo":["Конфедерация","Консерватизм","Плутократия/Олигархия","Демократия","Прямая демократия","Федерация","Либерализм","Социал-демократия"],"y0":1500,"y1":0,"name":"Швейцарский флаг (белый крест на красном)","src":"реальный","note":"Квадратный флаг; с 1848 федеральный флаг, пропорции креста закреплены в 1889 (плечо 7, ширина 6, сторона 32). Уверенность 5/5 Объединено одинаковых флагов: CH-1500."},{"id":"CH-1798","w":90,"svg":"<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 90 60\"><rect x=\"0\" y=\"0\" width=\"90\" height=\"20.05\" fill=\"#00A651\"/><rect x=\"0\" y=\"20\" width=\"90\" height=\"20.05\" fill=\"#E30613\"/><rect x=\"0\" y=\"40\" width=\"90\" height=\"20.05\" fill=\"#FFD100\"/></svg>","regime":"Гельветическая республика","ideo":["Демократия","Либерализм"],"y0":1798,"y1":1803,"name":"Зелёно-красно-жёлтый триколор","src":"реальный","note":"Единая республика под влиянием Франции: горизонтальные полосы зелёная, красная, жёлтая. Пропорции приблизительны. Уверенность 4/5"}],"CZ":[{"id":"CZ-1918","w":90,"svg":"<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 90 60\"><rect x=\"0\" y=\"0\" width=\"90\" height=\"30.05\" fill=\"#FFFFFF\"/><rect x=\"0\" y=\"30\" width=\"90\" height=\"30.05\" fill=\"#D7141A\"/></svg>","regime":"Чехословацкая республика (первый флаг)","ideo":["Монархия","Консерватизм","Демократия","Национализм","Либерализм"],"y0":1500,"y1":1920,"name":"Бело-красный флаг","src":"реальный","note":"Первый флаг ЧСР 1918–20, совпадал с флагом Богемии (из-за него синий клин добавили в 1920). Уверенность 5/5. Объединено одинаковых флагов: CZ-1500."},{"id":"CZ-1993","w":90,"svg":"<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 90 60\"><rect x=\"0\" y=\"0\" width=\"90\" height=\"30.05\" fill=\"#FFFFFF\"/><rect x=\"0\" y=\"30\" width=\"90\" height=\"30.05\" fill=\"#D7141A\"/><polygon points=\"0,0 45,30 0,60\" fill=\"#11457E\"/></svg>","regime":"Чешская Республика","ideo":["Демократия","Либерализм","Социал-демократия","Национализм","Консерватизм","Социализм","Коммунизм","Однопартийное","Федерация"],"y0":1920,"y1":0,"name":"Современный флаг Чехии","src":"реальный","note":"Тот же дизайн: ЧФСР 1990–92, Чехия с 1993 (Федерация только до 1992). Уверенность 5/5. Объединено одинаковых флагов: CZ-1920, CZ-1945, CZ-1948."},{"id":"CZ-1939","w":90,"svg":"<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 90 60\"><re