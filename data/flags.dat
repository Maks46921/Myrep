th=\"1.98\" height=\"18\"/><rect x=\"29.5\" y=\"44.4\" width=\"11\" height=\"1.98\"/><rect x=\"31.7\" y=\"41.16\" width=\"6.6\" height=\"1.98\"/></g></g></g></g></svg>","regime":"Великое княжество Литовское","ideo":["Монархия","Консерватизм","Конфедерация"],"y0":1500,"y1":1795,"name":"Красное знамя с Погоней (Витис)","src":"реальный","note":"Красное знамя с белым всадником (Погоня), символ Великого княжества Литовского и Беларуси; всадник упрощён до силуэта, щит с двойным крестом. Уверенность 4/5."},{"id":"BY-1991","w":120,"svg":"<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 120 60\"><rect x=\"0\" y=\"0\" width=\"120\" height=\"20.05\" fill=\"#FFFFFF\"/><rect x=\"0\" y=\"20\" width=\"120\" height=\"20.05\" fill=\"#D22730\"/><rect x=\"0\" y=\"40\" width=\"120\" height=\"20.05\" fill=\"#FFFFFF\"/></svg>","regime":"Республика Беларусь (1991–1995)","ideo":["Демократия","Социал-демократия","Либерализм","Национализм","Нацизм/фашизм"],"y0":1918,"y1":1995,"name":"Бело-красно-белый флаг независимой Беларуси","src":"реальный","note":"Государственный флаг 1991–1995 (до референдума); сегодня символ оппозиции. Уверенность 5/5. Объединено одинаковых флагов: BY-1918, BY-1943."},{"id":"BY-1919","w":120,"svg":"<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 120 60\"><rect x=\"0\" y=\"0\" width=\"120\" height=\"60\" fill=\"#CD0000\"/></svg>","regime":"ССРБ / Белорусская ССР (ранний период)","ideo":["Республика советов","Коммунизм","Социализм","Однопартийное"],"y0":1919,"y1":1951,"name":"Красный флаг ССРБ/БССР","src":"реальный","note":"Красное полотнище с золотой надписью ССРБ, с 1937 БССР; надпись и эмблема опущены. Уверенность 4/5."},{"id":"BY-1921","w":96,"svg":"<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 96 60\"><rect x=\"0\" y=\"0\" width=\"96\" height=\"30.05\" fill=\"#FFFFFF\"/><rect x=\"0\" y=\"30\" width=\"96\" height=\"30.05\" fill=\"#DC143C\"/></svg>","regime":"Вторая Речь Посполитая (Западная Беларусь)","ideo":["Национализм","Консерватизм","Хунта"],"y0":1921,"y1":1939,"name":"Бело-красный флаг Польши","src":"реальный","note":"Государственный флаг Польши, под властью которой в 1921–1939 была Западная Беларусь. Уверенность 5/5."},{"id":"BY-1951","w":120,"svg":"<svg\n   xmlns:dc=\"http://purl.org/dc/elements/1.1/\"\n   xmlns:cc=\"http://creativecommons.org/ns#\"\n   xmlns:rdf=\"http://www.w3.org/1999/02/22-rdf-syntax-ns#\"\n   xmlns:svg=\"http://www.w3.org/2000/svg\"\n   xmlns=\"http://www.w3.org/2000/svg\"\n   xmlns:xlink=\"http://www.w3.org/1999/xlink\"\n   width=\"1200\"\n   height=\"600\"\n   viewBox=\"0 0 8853600 4426800\"\n   id=\"svg2\"\n   version=\"1.1\" xmlns:c2pa=\"http://c2pa.org/manifest\"><defs\n     id=\"defs46\" /><rect\n     width=\"8853600\"\n     height=\"4426800\"\n     id=\"rect4\"\n     style=\"opacity:1;fill:#009933;fill-opacity:1;stroke-width:1.33333337\"\n     x=\"0\"\n     y=\"2.3283064e-010\" /><rect\n     width=\"8853600\"\n     height=\"2951200\"\n     id=\"rect6\"\n     style=\"opacity:1;fill:#cc0000;stroke-width:1.33333337\"\n     x=\"0\"\n     y=\"2.3283064e-010\" /><g\n     style=\"fill:#ffd700;fill-opacity:1\"\n     id=\"g2900\"\n     transform=\"matrix(4866.1293,0,0,4853.4358,1248503.8,202973.42)\"><path\n       id=\"rect4165-6\"\n       d=\"m 137.43744,171.69421 18.86296,18.9937 17.78834,-17.66589 c 27.05847,29.021 55.43807,56.99501 82.28704,86.12782 4.03444,4.06233 10.59815,4.085 14.66056,0.0506 4.06232,-4.03445 4.08499,-10.59815 0.0506,-14.66056 -28.81871,-27.1901 -57.72545,-54.60143 -86.55328,-81.89095 l 23.96499,-23.80003 -33.34026,-4.61605 z\"\n       style=\"fill:#ffd700;fill-opacity:1;stroke:none;stroke-width:0.48919073;stroke-miterlimit:4;stroke-dasharray:none;stroke-dashoffset:0;stroke-opacity:1\" /><path\n       id=\"path4179-3\"\n       d=\"m 198.2887,110.1955 c 15.51743,8.7394 27.29872,21.28122 34.2484,34.3924 7.04394,13.28902 10.13959,27.16218 10.20325,38.25433 0.13054,22.74374 -18.43771,41.18184 -41.18183,41.18184 -12.13597,0 -23.04607,-5.24868 -30.58302,-13