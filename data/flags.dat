svg\" viewBox=\"0 0 90 60\"><rect x=\"0\" y=\"0\" width=\"90\" height=\"30.05\" fill=\"#000000\"/><rect x=\"0\" y=\"30\" width=\"90\" height=\"30.05\" fill=\"#FCDD09\"/></svg>","regime":"Габсбургская монархия","ideo":["Монархия","Консерватизм"],"y0":1700,"y1":1918,"name":"Чёрно-жёлтый флаг Габсбургов","src":"реальный","note":"Хорватия в составе Габсбургской монархии; чёрно-жёлтый биколор (уверенность 4/5)"},{"id":"HR-1809","w":90,"svg":"<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 90 60\"><rect x=\"0\" y=\"0\" width=\"30.05\" height=\"60\" fill=\"#0055A4\"/><rect x=\"30\" y=\"0\" width=\"30.05\" height=\"60\" fill=\"#FFFFFF\"/><rect x=\"60\" y=\"0\" width=\"30.05\" height=\"60\" fill=\"#EF4135\"/></svg>","regime":"Иллирийские провинции","ideo":["Монархия"],"y0":1809,"y1":1813,"name":"Французский триколор (Иллирийские провинции)","src":"реальный","note":"Далмация, Рагуза и часть Хорватии под Наполеоном; своего флага не было, использовался французский триколор (уверенность 4/5)"},{"id":"HR-1941","w":120,"svg":"<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 120 60\"><rect x=\"0\" y=\"0\" width=\"120\" height=\"20.05\" fill=\"#E2231A\"/><rect x=\"0\" y=\"20\" width=\"120\" height=\"20.05\" fill=\"#FFFFFF\"/><rect x=\"0\" y=\"40\" width=\"120\" height=\"20.05\" fill=\"#171796\"/></svg>","regime":"Независимое государство Хорватия","ideo":["Монархия","Национализм","Консерватизм","Нацизм/фашизм"],"y0":1848,"y1":1945,"name":"Хорватский триколор (НГХ)","src":"реальный","note":"Вместо государственного флага НГХ со щитом и знаком «У» усташей показан просто хорватский триколор, использовавшийся режимом; знак «У» не рисуется (уверенность 4/5) Объединено одинаковых флагов: HR-1848."},{"id":"HR-1918","w":90,"svg":"<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 90 60\"><rect x=\"0\" y=\"0\" width=\"90\" height=\"20.05\" fill=\"#0C4DA2\"/><rect x=\"0\" y=\"20\" width=\"90\" height=\"20.05\" fill=\"#FFFFFF\"/><rect x=\"0\" y=\"40\" width=\"90\" height=\"20