е герцогство Люксембург","ideo":["Монархия","Демократия","Либерализм","Консерватизм","Социал-демократия"],"y0":1845,"y1":0,"name":"Красно-бело-голубой триколор","src":"реальный","note":"Горизонтальный триколор (красный, белый, светло-голубой), введён 1845, закреплён законом 1993; пропорции 3:5. Уверенность 5/5"},{"w":90,"svg":"<svg xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\" width=\"900\" height=\"600\" version=\"1.0\" xmlns:c2pa=\"http://c2pa.org/manifest\"><path fill=\"#fff\" d=\"M0 0h900v600H0Z\"/><use xlink:href=\"#a\" transform=\"matrix(-1 0 0 1 900 0)\"/><path id=\"a\" fill=\"#d9171a\" d=\"m141.21326 46.741081-6.54193-30.838928 52.82368 35.215788 6.54193 30.83893 47.55693 31.704619-6.54193-30.838929 48.43768 32.291789 6.54193 30.83893 47.04745 31.36497-6.54193-30.83893 50.1895 33.45967 6.54193 30.83893 190.6152 127.07681 32.17839-5.02538 50.39443 33.22398-32.63086 5.09604L674.2771 402.117l32.57219-5.08688 49.08645 33.04834-32.17839 5.02538 46.80212 31.20142 32.47698-5.07201 49.26855 33.09139-32.17839 5.02538L900 552.59895V600h-71.27171l-68.88897-45.92598 6.83932 32.24083-52.92252-35.28169-6.83932-32.24083-47.64631-31.76421 6.83932 32.24083-48.52817-32.35211-6.83932-32.24083-47.13619-31.42413 6.83933 32.24083-50.2838-33.52253-6.83932-32.24083-190.6478-127.09855-33.64118 5.25383-48.46727-32.31151 33.64118-5.25383-46.62355-31.08237-33.64118 5.25382-48.46137-32.30758 33.64118-5.25383-46.69499-31.12999-33.641186 5.25382-51.089981-34.05999 33.64118-5.25383L0 47.514422.00001082 0H71.101648Z\"/></svg>","regime":"Испанские Нидерланды","ideo":["Монархия"],"y0":1500,"y1":1714,"name":"Бургундский крест","src":"Викисклад","note":"Flag with the cross of Burgundy (saltire). Also named Cross of Burgundy flag. It was used in the Catholic Monarchy and in its viceroyalties ","lic":"PD","author":"Ningyou.","url":"https://commons.wikimedia.org/wiki/File:Flag_of_Cross_of_Burgundy.svg","id":"LU-c1"}],"LV":[{"id":"LV-1629","w":96,"svg":"<svg xmln