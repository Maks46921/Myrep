,"Национализм","Консерватизм","Социализм","Коммунизм","Однопартийное"],"y0":1919,"y1":0,"name":"Современный флаг Польши","src":"реальный","note":"Бело-красный, 5:8; закреплён законом о гербе, цветах и гимне 1980 г. Уверенность 5/5. Объединено одинаковых флагов: PL-1919, PL-1944."},{"id":"PL-1927","w":96,"svg":"<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"1280\" height=\"800\" xmlns:c2pa=\"http://c2pa.org/manifest\"><path fill=\"#fff\" d=\"M0 0H1280V800H0z\"/><path fill=\"#e34234\" d=\"M0 400H1280V800H0z\"/></svg>","regime":"Санация (Вторая Речь Посполитая)","ideo":["Хунта","Национализм","Консерватизм"],"y0":1927,"y1":1939,"name":"Государственный флаг с орлом","src":"Викисклад","note":"Бело-красный флаг с орлом на белой полосе (для госучреждений и за границей, с 1927). Орёл упрощён. Уверенность 4/5.","lic":"PD","author":"Arvedui89","url":"https://commons.wikimedia.org/wiki/File:Flag_of_Poland_(1928%E2%80%931980).svg"},{"w":90,"svg":"<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"900\" height=\"600\" xmlns:c2pa=\"http://c2pa.org/manifest\"><path fill=\"#d52b1e\" d=\"M0 0h900v600H0z\"/><path fill=\"#0039a6\" d=\"M0 0h900v400H0z\"/><path fill=\"#64c8ff\" d=\"M0 0h900v200H0z\"/></svg>","regime":"ПНР","ideo":["Коммунизм"],"y0":1944,"y1":1989,"name":"Польская Народная Республика","src":"Викисклад","note":"Flag of Minecraft City","lic":"PD","author":"Revolver 45","url":"https://commons.wikimedia.org/wiki/File:Flag_of_the_Luhansk_People%27s_Republic.svg","id":"PL-c1"}],"PT":[{"id":"PT-1500","w":90,"svg":"<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 90 60\"><rect x=\"0\" y=\"0\" width=\"90\" height=\"60\" fill=\"#FFFFFF\"/><path d=\"M34.5,20.25 L55.5,20.25 L55.5,31.73 Q55.5,41.92 45,45.75 Q34.5,41.92 34.5,31.73 Z\" fill=\"#D6202C\" stroke=\"#FFFFFF\" stroke-width=\"0.75\"/><path d=\"M38.07,23.52 L51.93,23.52 L51.93,31.78 Q51.93,39.13 45,41.88 Q38.07,39.13 38.07,31.78 Z\" fill=\"#FFFFFF\"/><rect x=\"43.2\" y=\"30.42\" width=\"3.6\" height=\"3.96\" fill=\"#1B