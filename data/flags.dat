"y0": 2004,
"y1": 0,
"name": "Нынешний флаг Сербии",
"src": "реальный",
"note": "Красно-сине-белый триколор 2:3 с малым гербом (щит с крестом и четырьмя огнивами под короной), смещённым к древку; герб упрощён (уверенность 4/5)"
}],
