=\"0\" width=\"120\" height=\"60\" fill=\"#00335E\"/><g transform=\"translate(12 0) scale(0.9)\"><g fill=\"#FFD900\"><polygon points=\"26,38 46,34 58,30 60,32 50,38 30,44\"/><polygon points=\"56,30 60,30 74,50 66,52\"/><polygon points=\"30,44 46,44 52,50 24,50\"/><polygon points=\"60,32 74,12 78,14 66,34\"/><polygon points=\"40,36 44,36 44,50 40,50\"/></g><polygon points=\"20,4.8 20.72,7.01 23.04,7.01 21.16,8.38 21.88,10.59 20,9.22 18.12,10.59 18.84,8.38 16.96,7.01 19.28,7.01\" fill=\"#FFD900\"/><polygon points=\"32,2.8 32.72,5.01 35.04,5.01 33.16,6.38 33.88,8.59 32,7.22 30.12,8.59 30.84,6.38 28.96,5.01 31.28,5.01\" fill=\"#FFD900\"/><polygon points=\"44,5.8 44.72,8.01 47.04,8.01 45.16,9.38 45.88,11.59 44,10.22 42.12,11.59 42.84,9.38 40.96,8.01 43.28,8.01\" fill=\"#FFD900\"/><polygon points=\"56,8.8 56.72,11.01 59.04,11.01 57.16,12.38 57.88,14.59 56,13.22 54.12,14.59 54.84,12.38 52.96,11.01 55.28,11.01\" fill=\"#FFD900\"/><polygon points=\"70,12.8 70.72,15.01 73.04,15.01 71.16,16.38 71.88,18.59 70,17.22 68.12,18.59 68.84,16.38 66.96,15.01 69.28,15.01\" fill=\"#FFD900\"/><polygon points=\"76,20.8 76.72,23.01 79.04,23.01 77.16,24.38 77.88,26.59 76,25.22 74.12,26.59 74.84,24.38 72.96,23.01 75.28,23.01\" fill=\"#FFD900\"/><polygon points=\"82,30.8 82.72,33.01 85.04,33.01 83.16,34.38 83.88,36.59 82,35.22 80.12,36.59 80.84,34.38 78.96,33.01 81.28,33.01\" fill=\"#FFD900\"/></g></svg>","regime":"Ирландская гражданская армия (рабочее движение)","ideo":["Социализм","Коммунизм"],"y0":1914,"y1":0,"name":"Звёздный плуг","src":"движение","note":"Знамя ирландских социалистов и Ирландской гражданской армии: плуг и семь звёзд Большой Медведицы. Плуг упрощён. Уверенность 3/5"},{"id":"IE-1919","w":120,"svg":"<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 120 60\"><rect x=\"0\" y=\"0\" width=\"40.05\" height=\"60\" fill=\"#169B62\"/><rect x=\"40\" y=\"0\" width=\"40.05\" height=\"60\" fill=\"#FFFFFF\"/><rect x=\"80\" y=\"0\" width=\"40.05\" height=\"60\" fill=\"#FF883E\"/></svg>","regime":"Ирландская республика, Свободное государство и Ирландия","ideo":["Демократия","Социал-демократия","Либерализм","Консерватизм","Национализм"],"y0":1919,"y1":0,"name":"Ирландский триколор (зелёный, белый, оранжевый)","src":"реальный","note":"Флаг, поднятый в 1848 Т. Ф. Мигером; флаг Ирландской республики 1919–22, Свободного государства (доминиона 1922–37) и нынешней Ирландии (конституция 1937), пропорции 1:2. Уверенность 5/5"},{"w":100,"svg":"<svg viewBox=\"0 0 5 3\" height=\"600\" width=\"1000\" xmlns=\"http://www.w3.org/2000/svg\" xmlns:c2pa=\"http://c2pa.org/manifest\"><defs><clipPath id=\"a\"><rect height=\"3\" width=\"5\"></rect></clipPath></defs><rect fill=\"#fff\" height=\"3\" width=\"5\"></rect><path clip-path=\"url(#a)\" stroke-width=\".6\" stroke=\"#c8102e\" d=\"M 0,0 L 5,3 M 0,3 L 5,0\"></path></svg>","regime":"Королевство Ирландия","ideo":["Монархия"],"y0":1783,"y1":1801,"name":"Крест святого Патрика","src":"Викисклад","note":"This is \"Saint Patrick's saltire\", the third component of the Union Flag. It represents Ireland and is called \"Saint Patrick's cross/saltire","lic":"PD","author":"Hoshie and others","url":"https://commons.wikimedia.org/wiki/File:Saint_Patrick%27s_Saltire.svg","id":"IE-c1"}],"IT":[{"id":"IT-1500","w":90,"svg":"<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 90 60\"><rect x=\"0\" y=\"0\" width=\"90\" height=\"60\" fill=\"#FFFFFF\"/><rect x=\"0\" y=\"24\" width=\"90\" height=\"12\" fill=\"#CE1126\"/><rect x=\"39\" y=\"0\" width=\"12\" height=\"60\" fill=\"#CE1126\"/></svg>","regime":"Республика Генуя","ideo":["Консерватизм","Плутократия/Олигархия"],"y0":1500,"y1":1797,"name":"Крест святого Георгия Генуи","src":"реальный","note":"Красный крест на белом, флаг Генуэзской республики; позднее версия с гербовыми щитодержателями не рисуется. Уверенность 5/5"},{"id":"IT-1500s","w":90,"svg":"<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 90 60\"><rect x=\"0\" y=\"0\" width=\"90\" height=\"60\" fill=\"#CE1126\"/><rect x=\"17.1\" y=\"25\" width=\"55.8\" height=\"10\" fill=\"#FFFFFF\"/><rect x=\"40\" y=\"11.4\" width=\"10\" height=\"37.2\" fill=\"#FFFFFF\"/></svg>","regime":"Герцогство Савойя","ideo":["Монархия","Консерватизм"],"y0":1500,"y1":1720,"name":"Крест Савойи (белый на красном)","src":"реальный","note":"Знамя Савойского дома. Простой крест на красном; пропорции креста упрощены. Уверенность 3/5"},{"id":"IT-1808","w":90,"svg":"<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 90 60\"><rect x=\"0\" y=\"0\" width=\"45.05\" height=\"60\" fill=\"#F2C500\"/><rect x=\"45\" y=\"0\" width=\"45.05\" height=\"60\" fill=\"#FFFFFF\"/><g transform=\"translate(67.5 30)\"><line x1=\"-8\" y1=\"9\" x2=\"8\" y2=\"-7\" stroke=\"#C9A227\" stroke-width=\"2.4\"/><line x1=\"8\" y1=\"9\" x2=\"-8\" y2=\"-7\" stroke=\"#8D8D8D\" stroke-width=\"2.4\"/><circle cx=\"-8\" cy=\"-7.6\" r=\"2.5\" fill=\"#C9A227\"/><circle cx=\"8\" cy=\"-7.6\" r=\"2.5\" fill=\"#8D8D8D\"/><rect x=\"-11\" y=\"7.5\" width=\"5\" height=\"3\" fill=\"#C9A227\"/><rect x=\"6\" y=\"7.5\" width=\"5\" height=\"3\" fill=\"#8D8D8D\"/><g transform=\"translate(0 -1.5) scale(1.3)\"><polygon points=\"-4,2 4,2 3,-3 -3,-3\" fill=\"#B8860B\"/><polygon points=\"-3,-3 3,-3 2.2,-6.4 -2.2,-6.4\" fill=\"#C9A227\"/><polygon points=\"-2.2,-6.4 2.2,-6.4 0,-10.5\" fill=\"#E0B93A\"/></g></g></svg>","regime":"Папская область","ideo":["Теократия","Монархия","Консерватизм"],"y0":1808,"y1":1870,"name":"Жёлто-белый флаг Папской области","src":"реальный","note":"Жёлтый и белый (с 1808), на белой части герб Святого Престола: тиара и скрещённые ключи, сильно упрощены. До 1808 флаги были красно-жёлтыми. Уверенность 4/5"},{"id":"IT-1797","w":90,"svg":"<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 90 60\"><rect x=\"0\" y=\"0\" width=\"90\" height=\"20.05\" fill=\"#CE2B37\"/><rect x=\"0\" y=\"20\" width=\"90\" height=\"20.05\" fill=\"#FFFFFF\"/><rect x=\"0\" y=\"40\" width=\"90\" height=\"20.05\" fill=\"#009246\"/><circle cx=\"45\" cy=\"30\" r=\"10.5\" fill=\"none\" stroke=\"#2E7D32\" stroke-width=\"2\"/><line x1=\"40.5\" y1=\"38\" x2=\"38.25\" y2=\"22\" stroke=\"#7A4A1E\" stroke-width=\"1.2\"/><line x1=\"43.5\" y1=\"38\" x2=\"42.75\" y2=\"22\" stroke=\"#7A4A1E\" stroke-width=\"1.2\"/><line x1=\"46.5\" y1=\"38\" x2=\"47.25\" y2=\"22\" stroke=\"#7A4A1E\" stroke-width=\"1.2\"/><line x1=\"49.5\" y1=\"38\" x2=\"51.75\" y2=\"22\" stroke=\"#7A4A1E\" stroke-width=\"1.2\"/><rect x=\"41\" y=\"33\" width=\"8\" height=\"5\" fill=\"#7A4A1E\"/></svg>","regime":"Циспаданская республика","ideo":["Демократия","Либерализм","Национализм"],"y0":1797,"y1":1797,"name":"Первый итальянский триколор (красный-белый-зелёный)","src":"реальный","note":"Горизонтальный триколор Реджо-Эмилии 1797: красный, белый, зелёный; в центре колчан и трофей с 4 стрелами (4 провинции) в лавровом венке — упрощены. Уверенность 4/5"},{"id":"IT-1802","w":90,"svg":"<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 90 60\"><rect x=\"0\" y=\"0\" width=\"90\" height=\"60\" fill=\"#CE2B37\"/><polygon points=\"45,4 75,30 45,56 15,30\" fill=\"#FFFFFF\"/><polygon points=\"35,20 55,20 55,40 35,40\" fill=\"#009246\"/></svg>","regime":"Итальянская республика (Наполеон)","ideo":["Демократия","Либерализм","Национализм"],"y0":1802,"y1":1805,"name":"Красное полотнище с белым ромбом и зелёным квадратом","src":"реальный","note":"Флаг президента Бонапарта: красный фон, белый ромб, в нём зелёный квадрат. Уверенность 4/5"},{"id":"IT-1848","w":90,"svg":"<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 90 60\"><rect x=\"0\" y=\"0\" width=\"30.05\" height=\"60\" fill=\"#008C45\"/><rect x=\"30\" y=\"0\" width=\"30.05\" height=\"60\" fill=\"#F4F5F0\"/><rect x=\"60\" y=\"0\" width=\"30.05\" height=\"60\" fill=\"#CD212A\"/><path d=\"M37.5,23.5 L52.5,23.5 L52.5,32.05 Q52.5,39.65 45,42.5 Q37.5,39.65 37.5,32.05 Z\" fill=\"#CD212A\" stroke=\"#1B3F94\" stroke-width=\"1.4\"/><rect x=\"38.5\" y=\"29.02\" width=\"13\" height=\"3.4\" fill=\"#FFFFFF\"/><rect x=\"43.3\" y=\"24.5\" width=\"3.4\" height=\"16.15\" fill=\"#FFFFFF\"/><g transform=\"translate(45 15.5) scale(1)\" fill=\"#C9A227\"><polygon points=\"-6,4 -6,-3 -3,0 0,-5 3,0 6,-3 6,4\"/><rect x=\"-6\" y=\"4.5\" width=\"12\" height=\"1.8\"/></g></svg>","regime":"Королевство Сардиния и Королевство Италия","ideo":["Монархия","Консерватизм","Национализм","Либерализм","Нацизм/фашизм"],"y0":1848,"y1":1946,"name":"Триколор с гербом Савойского дома","src":"реальный","note":"Флаг с савойским щитом (белый крест на красном с синей каймой) и короной; для фашистского периода 1922–43 флаг остался тем же (государственный, без партийных символов — фасций на нём не рисуем). Уверенность 4/5"},{"id":"IT-1943","w":90,"svg":"<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 90 60\"><rect x=\"0\" y=\"0\" width=\"30.05\" height=\"60\" fill=\"#008C45\"/><rect x=\"30\" y=\"0\" width=\"30.05\" height=\"60\" fill=\"#F4F5F0\"/><rect x=\"60\" y=\"0\" width=\"30.05\" height=\"60\" fill=\"#CD212A\"/></svg>","regime":"Итальянская социальная республика (Сало)","ideo":["Нацизм/фашизм","Однопартийное","Национализм"],"y0":1943,"y1":1945,"name":"Государственный триколор РСИ","src":"реальный","note":"Вместо военного флага с орлом и фасцией — государственный триколор без эмблемы (такой же, как у нынешней республики). Уверенность 4/5"},{"id":"IT-1946","w":90,"svg":"<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 90 60\"><rect x=\"0\" y=\"0\" width=\"30.05\" height=\"60\" fill=\"#009246\"/><rect x=\"30\" y=\"0\" width=\"30.05\" height=\"60\" fill=\"#F1F2F1\"/><rect x=\"60\" y=\"0\" width=\"30.05\" height=\"60\" fill=\"#CE2B37\"/></svg>","regime":"Итальянская Республика","ideo":["Демократия","Социал-демократия","Либерализм","Консерватизм"],"y0":1946,"y1":0,"name":"Триколор Италии (нынешний)","src":"реальный","note":"Зелёный, белый, красный; с 1 января 1948 по конституции. Уверенность 5/5"},{"id":"IT-1874","w":90,"svg":"<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 90 60\"><rect x=\"0\" y=\"0\" width=\"90\" height=\"60\" fill=\"#111111\"/></svg>","regime":"Анархисты Италии","ideo":["Анархизм"],"y0":1874,"y1":0,"name":"Чёрное знамя","src":"движение","note":"Чёрное знамя итальянских анархистов (Бакунин, Малатеста). Уверенность 4/5"},{"id":"IT-1892","w":90,"svg":"<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 90 60\"><rect x=\"0\" y=\"0\" width=\"90\" height=\"60\" fill=\"#D40000\"/></svg>","regime":"Социалисты и коммунисты Италии","ideo":["Социализм","Коммунизм"],"y0":1892,"y1":0,"name":"Красное знамя","src":"движение","note":"Простое красное знамя рабочего движения (ИСП 1892, ИКП 1921). Уверенность 4/5"}],"LT":[{"id":"LT-1500","w":90,"svg":"<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 90 60\"><rect x=\"0\" y=\"0\" width=\"90\" height=\"60\" fill=\"#C8102E\"/><g transform=\"translate(45 32) scale(0.56)\"><g transform=\"translate(-50 -50)\"><g fill=\"#fff\" stroke=\"#fff\" stroke-width=\"0.5\" stroke-linejoin=\"round\" transform=\"translate(0 16) scale(1 0.82)\"><polygon points=\"83.48,47.01 83.35,50.34 81.63,53.79 78.44,57.12 73.99,60.09 68.59,62.52 62.6,64.23 56.43,65.1 50.51,65.08 45.24,64.17 40.97,62.43 38,59.98 36.52,56.99 36.65,53.66 38.37,50.21 41.56,46.88 46.01,43.91 51.41,41.48 57.4,39.77 63.57,38.9 69.49,38.92 74.76,39.83 79.03,41.57 82,44.02\"/><polygon points=\"52,50 51.66,52.85 50.66,55.5 49.07,57.78 47,59.53 44.59,60.63 42,61 39.41,60.63 37,59.53 34.93,57.78 33.34,55.5 32.34,52.85 32,50 32.34,47.15 33.34,44.5 34.93,42.22 37,40.47 39.41,39.37 42,39 44.59,39.37 47,40.47 49.07,42.22 50.66,44.5 51.66,47.15\"/><polygon points=\"52.32,44.45 52.07,44.35 51.7,44.06 51.2,43.57 50.58,42.91 49.83,42.05 48.95,41.01 47.96,39.78 46.83,38.36 45.71,36.94 44.59,35.53 43.46,34.11 42.34,32.69 41.22,31.27 40.09,29.86 38.97,28.44 37.86,27.04 36.82,25.72 35.82,24.45 34.87,23.22 33.97,22.05 33.11,20.92 32.31,19.85 31.55,18.82 30.82,17.81 30.14,16.9 29.54,16.13 29.02,15.5 28.58,15.01 28.21,14.66 27.93,14.45 27.72,14.38 18.28,19.62 18.23,19.84 18.25,20.1