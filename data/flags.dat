":["Монархия","Консерватизм"],"y0":1500,"y1":1795,"name":"Знамя герцогства: красный лев на бело-голубых полосах","src":"реальный","note":"Геральдическое знамя (10 полос, красный лев); корона и когти упрощены; сегодня это «Roude Léiw» (пропорции 5:7). Уверенность 3/5"},{"id":"LU-1845","w":100,"svg":"<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 100 60\"><rect x=\"0\" y=\"0\" width=\"100\" height=\"20.05\" fill=\"#ED2939\"/><rect x=\"0\" y=\"20\" width=\"100\" height=\"20.05\" fill=\"#FFFFFF\"/><rect x=\"0\" y=\"40\" width=\"100\" height=\"20.05\" fill=\"#00A1DE\"/></svg>","regime":"Великое герцогство Люксембург","ideo":["Монархия","Демократия","Либерализм","Консерватизм","Социал-демократия"],"y0":1845,"y1":0,"name":"Красно-бело-голубой триколор","src":"реальный","note":"Горизонтальный триколор (красный, белый, светло-голубой), введён 1845, закреплён законом 1993; пропорции 3:5. Уверенность 5/5"}],"LV":[{"id":"LV-1629","w":96,"svg":"<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 96 60\"><rect x=\"0\" y=\"0\" width=\"96\" height=\"60\" fill=\"#006AA7\"/><rect x=\"0\" y=\"24\" width=\"96\" height=\"12\" fill=\"#FECC00\"/><rect x=\"30\" y=\"0\" width=\"12\" height=\"60\" fill=\"#FECC00\"/></svg>","regime":"Шведская Ливония","ideo":["Монархия","Консерватизм"],"y0":1629,"y1":1710,"name":"Флаг Швеции","src":"реальный","note":"Шведский флаг (жёлтый скандинавский крест на синем): Лифляндия принадлежала Швеции в 1629–1710 (Рига с 1621). Уверенность 4/5."},{"id":"LV-1990","w":120,"svg":"<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 120 60\"><rect x=\"0\" y=\"0\" width=\"120\" height=\"24.05\" fill=\"#9E3039\"/><rect x=\"0\" y=\"24\" width=\"120\" height=\"12.05\" fill=\"#FFFFFF\"/><rect x=\"0\" y=\"36\" width=\"120\" height=\"24.05\" fill=\"#9E3039\"/></svg>","regime":"Латвийская Республика (с 1990)","ideo":["Демократия","Либерализм","Социал-демократия","Национализм","Консерватизм","Однопартийное","Хунта"],"y0":1918,"y1":0,"name":"Государственный флаг Латвии","src":"реальный","note":"Восстановлен в 1990 (красно-бело-красный, 1:2). Уверенность 5/5. Объединено одинаковых флагов: LV-1918, LV-1934."},{"id":"LV-1940","w":120,"svg":"<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 120 60\"><rect x=\"0\" y=\"0\" width=\"120\" height=\"60\" fill=\"#CD0000\"/></svg>","regime":"Латвийская ССР (1940–1953)","ideo":["Республика советов","Коммунизм","Социализм","Однопартийное"],"y0":1919,"y1":1953,"name":"Красный флаг Латвийской ССР","src":"реальный","note":"Красное полотнище с золотой надписью (LPSR); надпись опущена. Уверенность 3/5. Объединено одинаковых флагов: LV-1919."},{"id":"LV-1953","w":120,"svg":"<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 120 60\"><rect x=\"0\" y=\"0\" width=\"120\" height=\"60\" fill=\"#CD0000\"/><path d=\"M0,38 Q3,35.8 6,38 T12,38 Q15,35.8 18,38 T24,38 Q27,35.8 30,38 T36,38 Q39,35.8 42,38 T48,38 Q51,35.8 54,38 T60,38 Q63,35.8 66,38 T72,38 Q75,35.8 78,38 T84,38 Q87,35.8 90,38 T96,38 Q99,35.8 102,38 T108,38 Q111,35.8 114,38 T120,38 Q123,35.8 126,38 T132,38 L132,60 L0,60 Z\" fill=\"#fff\"/><path d=\"M0,43.5 Q3,41.3 6,43.5 T12,43.5 Q15,41.3 18,43.5 T24,43.5 Q27,41.3 30,43.5 T36,43.5 Q39,41.3 42,43.5 T48,43.5 Q51,41.3 54,43.5 T60,43.5 Q63,41.3 66,43.5 T72,43.5 Q75,41.3 78,43.5 T84,43.5 Q87,41.3 90,43.5 T96,43.5 Q99,41.3 102,43.5 T108,43.5 Q111,41.3 114,43.5 T120,43.5 Q123,41.3 126,43.5 T132,43.5 L132,60 L0,60 Z\" fill=\"#1E78C8\"/><path d=\"M0,49 Q3,46.8 6,49 T12,49 Q15,46.8 18,49 T24,49 Q27,46.8 30,49 T36,49 Q39,46.8 42,49 T48,49 Q51,46.8 54,49 T60,49 Q63,46.8 66,49 T72,49 Q75,46.8 78,49 T84,49 Q87,46.8 90,49 T96,49 Q99,46.8 102,49 T108,49 Q111,46.8 114,49 T120,49 Q123,46.8 126,49 T132,49 L132,60 L0,60 Z\" fill=\"#fff\"/><path d=\"M0,54.5 Q3,52.3 6,54.5 T12,54.5 Q15,52.3 18,54.5 T24,54.5 Q27,52.3 30,54.5 T36,54.5 Q39,52.3 42,54.5 T48,54.5 Q51,52.3 54,54.5 T60,54.5 Q63,52.3 66,54.5 T72,54.5 Q75,52.3 78,54.5 T84,54.5 Q87,52.3 90,54.5 T96,54.5 Q99,52.3 102,54.5 T108,54.5 Q111,52.3 1