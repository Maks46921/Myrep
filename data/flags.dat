"regime": "Временное правительство / Российская республика",
"ideo": ["Демократия", "Либерализм", "Социал-демократия"],
"y0": 1917,
"y1": 1917,
"name": "Триколор Временного правительства",
"src": "реальный",
"note": "Временное правительство формально не вводило нового флага, использовало бело-сине-красный триколор (и красные флаги революции). Уверенность 4/5."
}, {
"id": "LV-1918",
"w": 120,
"svg": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 120 60\"><rect x=\"0\" y=\"0\" width=\"120\" height=\"24.05\" fill=\"#9E3039\"/><rect x=\"0\" y=\"24\" width=\"120\" height=\"12.05\" fill=\"#FFFFFF\"/><rect x=\"0\" y=\"36\" width=\"120\" height=\"24.05\" fill=\"#9E3039\"/></svg>",
"regime": "Латвийская Республика",
"ideo": ["Демократия", "Либерализм", "Социал-демократия", "Национализм", "Консерватизм"],
"y0": 1918,
"y1": 1934,
"name": "Красно-бело-красный флаг Латвии",
"src": "реальный",
"note": "Тёмно-красный (кармин) флаг с белой полосой (1/5 высоты), 1:2; принят в 1918, закон 1921. Уверенность 5/5."
}, {
"id": "LV-1934",
"w": 120,
"svg": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 120 60\"><rect x=\"0\" y=\"0\" width=\"120\" height=\"24.05\" fill=\"#9E3039\"/><rect x=\"0\" y=\"24\" width=\"120\" height=\"12.05\" fill=\"#FFFFFF\"/><rect x=\"0\" y=\"36\" width=\"120\" height=\"24.05\" fill=\"#9E3039\"/></svg>",
"regime": "Режим Ульманиса (авторитарная Латвия)",
