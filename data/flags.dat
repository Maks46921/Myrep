w3.org/2000/svg\" viewBox=\"0 0 90 60\"><rect x=\"0\" y=\"0\" width=\"90\" height=\"60\" fill=\"#111111\"/></svg>","regime":"Анархисты Испании","ideo":["Анархизм"],"y0":1869,"y1":0,"name":"Чёрное знамя","src":"движение","note":"Чёрное знамя анархистов Испании (с 1870-х). Уверенность 4/5"},{"id":"ES-1920","w":90,"svg":"<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 90 60\"><rect x=\"0\" y=\"0\" width=\"90\" height=\"60\" fill=\"#D40000\"/></svg>","regime":"Социалисты и коммунисты Испании","ideo":["Социализм","Коммунизм"],"y0":1879,"y1":0,"name":"Красное знамя","src":"движение","note":"Простое красное знамя ПСОЭ и КПИ, на войне 1936–39 рядом с республиканским триколором. Уверенность 4/5"},{"id":"ES-1936f","w":90,"svg":"<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 90 60\"><rect x=\"0\" y=\"0\" width=\"90\" height=\"15.05\" fill=\"#AA151B\"/><rect x=\"0\" y=\"15\" width=\"90\" height=\"30.05\" fill=\"#F1BF00\"/><rect x=\"0\" y=\"45\" width=\"90\" height=\"15.05\" fill=\"#AA151B\"/></svg>","regime":"Франкистская Испания","ideo":["Нацизм/фашизм","Национализм","Однопартийное","Хунта","Консерватизм"],"y0":1936,"y1":1975,"name":"Красно-жёлто-красный флаг без орла","src":"реальный","note":"Заменено: вместо флага 1938–77 с орлом св. Иоанна, ярмом и стрелами Фаланги — простой флаг мятежников 1936 (красно-жёлто-красный 1:2:1, использован до введения орла). Уверенность 4/5"},{"id":"ES-1981","w":90,"svg":"<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 90 60\"><rect x=\"0\" y=\"0\" width=\"90\" height=\"15.05\" fill=\"#AA151B\"/><rect x=\"0\" y=\"15\" width=\"90\" height=\"30.05\" fill=\"#F1BF00\"/><rect x=\"0\" y=\"45\" width=\"90\" height=\"15.05\" fill=\"#AA151B\"/><path d=\"M21.9,19.88 L38.1,19.88 L38.1,28.99 Q38.1,37.09 30,40.12 Q21.9,37.09 21.9,28.99 Z\" fill=\"#FFFFFF\" stroke=\"#6B4A00\" stroke-width=\"0.81\"/><rect x=\"22.3\" y=\"20.28\" width=\"7.7\" height=\"8.5\" fill=\"#C8102E\"/><rect x=\"25.95\" y=\"23.93\" width=\"3.24\" height=\"3.51\" 