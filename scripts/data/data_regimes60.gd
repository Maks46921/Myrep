]

const UQ_MECH60 := {"lot": {"id": "lot", "n": "Жребий вместо выборов", "d": "Часть мест и должностей раздаётся жеребьёвкой среди граждан. Выборы остаются, но чем выше показатель, тем сильнее итог зависит от жребия, а не от рейтингов партий.", "m": {"corr_shift": -5.0, "mood_shift": 0.06, "eff_bonus": -0.006, "growth_bonus": -0.1, "dem_shift": 0.02}, "b": [{"id": "more", "l": "Расширить жребий: больше мест по жеребьёвке", "cost": 3.0, "cd": 6, "d": 15.0, "tip": "Показатель +15: итог выборов всё меньше зависит от рейтингов. Бизнес недоволен непредсказуемостью, молодёжь рада.", "fx": {"support": {"Бизнес": -2.0, "Бюджетники": 1.0, "Молодёжь": 2.0}}}, {"id": "less", "l": "Вернуть обычные выборы на часть мест", "cost": 2.0, "cd": 6, "d": -15.0, "tip": "Показатель −15: места опять завоёвываются голосами.", "fx": {"support": {"Бизнес": 1.0, "Молодёжь": -1.0}}}], "drift": -1.0, "h": "Влияет на выборы: доли партий усредняются и перемешиваются случайно (до 60%)."}, "veto": {"id": "veto", "n": "Вето одного депутата", "d": "Любой депутат (или представитель общины) может остановить закон. Всё решается только согласием, и меньшинство защищено. Зато реформы идут тяжело.", "m": {"growth_bonus": -0.08, "corr_shift": -1.0, "capital_bonus": -0.12, "sec_bonus": 0.5, "mood_shift": 0.01, "reg_unrest_shift": -1.5}, "b": [{"id": "more", "l": "Закрепить вето за каждым депутатом", "cost": 2.0, "cd": 6, "d": 15.0, "tip": "Показатель +15: меньшинства защищены, политкапитал дороже.", "fx": {"support": {"Силовики": -1.0, "Экологи": 1.0}}}, {"id": "less", "l": "Ограничить вето: нужен второй депутат", "cost": 3.0, "cd": 6, "d": -15.0, "tip": "Показатель −15: реформы проще, меньшинства недовольны.", "fx": {"support": {"Бизнес": 1.0, "Экологи": -1.0}}}], "drift": 0.0, "h": "Каждое вето обходится дороже политкапитала, зато дольше держит власть мирной."}, "union": {"id": "union", "n": "Два государства в одном", "d": "Два государства (или два «этажа» власти) сидят под одной крышей: общий рынок, общие о