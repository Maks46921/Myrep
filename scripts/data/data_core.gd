const COUNTRY_CODES := ["DE", "FR", "NL", "BE", "LU", "AT", "CH", "CZ", "DK", "ES", "IT", "NO", "PL", "PT", "SE", "GB", "IE", "SI", "SK", "HU", "FI", "HR", "RS", "BA", "ME", "MK", "AL", "XK", "BG", "RO", "GR", "EE", "LV", "LT"]

func ext_load(path: String):
	var txt := FileAccess.get_file_as_string(path)
	if txt == "":
		push_error("Нет файла данных: " + path)
		return null
	return str_to_var(txt)

func ext_load_countries() -> Dictionary:
	var out := {}
	for c in COUNTRY_CODES:
		var d = ext_load("res://data/countries/%s.dat" % c)
		if d != null:
			out[c] = d
	return out
