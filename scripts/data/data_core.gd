# иначе редактор Godot виснет на строках по 40 000 символов. Править через tools/extdump.gd / pretty-файлы.
const COUNTRY_CODES := ["DE", "FR", "NL", "BE", "LU", "AT", "CH", "CZ", "DK", "ES", "IT", "NO", "PL", "PT", "SE", "GB", "IE", "SI", "SK", "HU", "FI"]

func ext_load(path: String):
	var txt := FileAccess.get_file_as_string(path)
	if txt == "":
		push_error("Нет файла данных: " + path)
		return null
	return str_to_var(txt)

func ext_load_countries() -> Dictionary:
	var out := {}
	for c in COUNTRY_CODES:
		var d = ext_load("res://data/countries/%s.dat" % c)
		if d != null:
			out[c] = d
	return out
